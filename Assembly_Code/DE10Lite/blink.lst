0000              1   ; Assuming P1.0 is mapped to GPIO_0 (Pin 1 of JP1)
0000              2   MainLoop:
0000 D290         3       setb P1.0           ; Turn MOSFET ON (Speaker moves out)
0002 12000C       4       lcall ShortDelay    ; Wait (Note frequency depends on this)
0005 C290         5       clr P1.0            ; Turn MOSFET OFF (Speaker moves back)
0007 12000C       6       lcall ShortDelay    ; Wait
000A 80F4         7       sjmp MainLoop       ; Repeat to create a continuous sound
000C              8   
000C              9   ; A shorter delay routine for audible frequencies
000C             10   ShortDelay:
000C 7864        11       mov R0, #100        ; Adjust this number to change the pitch
000E D8FE        12   D1: djnz R0, D1         ; Higher number = lower pitch
0010 22          13       ret
