0000              1   ; ISR_example_DE10Lite.asm:
0000              2   ; a) Increments/decrements a BCD variable every half second using
0000              3   ;    an ISR for timer 2.  Uses SW0 to decide.  Also 'blinks' LEDR0 every
0000              4   ;    half a second.
0000              5   ; b) Generates a 2kHz square wave at pin P1.5 using an ISR for timer 0.
0000              6   ; c) In the 'main' loop it displays the variable incremented/decremented
0000              7   ;    using the ISR for timer 2 on the LCD and the 7-segment displays.
0000              8   ;    Also resets it to zero if the KEY1 pushbutton  is pressed.
0000              9   ; d) Controls the LCD using general purpose pins P2.3, P2.5, P2.7, P3.1, P3.3, P3.5, P3.7
0000             10   ;
                 12   $LIST
0000             14   
0000             15   CLK           EQU 33333333 ; Microcontroller system crystal frequency in Hz
0000             16   TIMER0_RATE   EQU 4096     ; 2048Hz squarewave (peak amplitude of CEM-1203 speaker)
0000             17   TIMER0_RELOAD EQU ((65536-(CLK/(12*TIMER0_RATE)))) ; The prescaler in the CV-8052 is always 12 unlike the N76E003 where is selectable.
0000             18   TIMER2_RATE   EQU 1000     ; 1000Hz, for a timer tick of 1ms
0000             19   TIMER2_RELOAD EQU ((65536-(CLK/(12*TIMER2_RATE))))
0000             20   
0000             21   SOUND_OUT     equ P1.5
0000             22   UPDOWN        equ SWA.0
0000             23   Play_beeps_Switch   equ SWA.1
0000             24   
0000             25   ; Reset vector
0000             26   org 0x0000
0000 0201B5      27       ljmp main
0003             28   
0003             29   ; External interrupt 0 vector (not used in this code)
0003             30   org 0x0003
0003 32          31            reti
0004             32   
0004             33   ; Timer/Counter 0 overflow interrupt vector
000B             34   org 0x000B
000B 02010B      35            ljmp Timer0_ISR
000E             36   
000E             37   ; External interrupt 1 vector (not used in this code)
0013             38   org 0x0013
0013 32          39            reti
0014             40   
0014             41   ; Timer/Counter 1 overflow interrupt vector (not used in this code)
001B             42   org 0x001B
001B 32          43            reti
001C             44   
001C             45   ; Serial port receive/transmit interrupt vector (not used in this code)
0023             46   org 0x0023 
0023 32          47            reti
0024             48            
0024             49   ; Timer/Counter 2 overflow interrupt vector
002B             50   org 0x002B
002B 02012B      51            ljmp Timer2_ISR
002E             52   
002E             53   ; In the 8051 we can define direct access variables starting at location 0x30 up to location 0x7F
0030             54   dseg at 0x30
0030             55   Count1ms:     ds 2 ; Used to determine when half second has passed
0032             56   BCD_counter:  ds 1 ; The BCD counter incrememted in the ISR and displayed in the main loop
0033             57   
0033             58   ; In the 8051 we have variables that are 1-bit in size.  We can use the setb, clr, jb, and jnb
0033             59   ; instructions with these variables.  This is how you define a 1-bit variable:
0000             60   bseg
0000             61   half_seconds_flag: dbit 1 ; Set to one in the ISR every time 500 ms had passed
0001             62   
002E             63   cseg
002E             64   ; These 'equ' must match the wiring between the DE10Lite board and the LCD!
002E             65   ; P0 is in connector JPIO.  Check "CV-8052 Soft Processor in the DE10Lite Board: Getting
002E             66   ; Started Guide" for the details.
002E             67   ELCD_RS equ P3.7
002E             68   ELCD_RW equ P3.5
002E             69   ELCD_E  equ P3.3
002E             70   ELCD_D4 equ P3.1
002E             71   ELCD_D5 equ P2.7
002E             72   ELCD_D6 equ P2.5
002E             73   ELCD_D7 equ P2.3
                 75   	$LIST
00E7             77   
00E7             78   ;                     1234567890123456    <- This helps determine the location of the counter
00E7 4243445F    79   Initial_Message:  db 'BCD_counter: xx ', 0
     636F756E
     7465723A
     20787820
     00
00F8             80   
00F8             81   ;---------------------------------;
00F8             82   ; Routine to initialize the ISR   ;
00F8             83   ; for timer 0                     ;
00F8             84   ;---------------------------------;
00F8             85   Timer0_Init:
00F8 E589        86            mov a, TMOD
00FA 54F0        87            anl a, #0xf0 ; Clear the bits for timer 0
00FC 4401        88            orl a, #0x01 ; Configure timer 0 as 16-timer
00FE F589        89            mov TMOD, a
0100 758CFD      90            mov TH0, #high(TIMER0_RELOAD)
0103 758A5A      91            mov TL0, #low(TIMER0_RELOAD)
0106             92            ; Enable the timer and interrupts
0106 D2A9        93       setb ET0  ; Enable timer 0 interrupt
0108 C28C        94       clr TR0  ; Start timer 0
010A 22          95            ret
010B             96   
010B             97   ;---------------------------------;
010B             98   ; ISR for timer 0.  Set to execute;
010B             99   ; every 1/4096Hz to generate a    ;
010B            100   ; 2048 Hz square wave at pin P3.7 ;
010B            101   ;---------------------------------;
010B            102   Timer0_ISR:
010B            103            ;clr TF0  ; According to the data sheet this is done for us already.
010B 758CFD     104            mov TH0, #high(TIMER0_RELOAD) ; Timer 0 doesn't have autoreload in the CV-8052
010E 758A5A     105            mov TL0, #low(TIMER0_RELOAD)
0111            106            ;cpl SOUND_OUT ; Connect speaker to P3.7!
0111 32         107            reti
0112            108   
0112            109   ;---------------------------------;
0112            110   ; Routine to initialize the ISR   ;
0112            111   ; for timer 2                     ;
0112            112   ;---------------------------------;
0112            113   Timer2_Init:
0112 75C800     114            mov T2CON, #0 ; Stop timer/counter.  Autoreload mode.
0115 75CDF5     115            mov TH2, #high(TIMER2_RELOAD)
0118 75CC27     116            mov TL2, #low(TIMER2_RELOAD)
011B            117            ; Set the reload value
011B 75CBF5     118            mov RCAP2H, #high(TIMER2_RELOAD)
011E 75CA27     119            mov RCAP2L, #low(TIMER2_RELOAD)
0121            120            ; Init One millisecond interrupt counter.  It is a 16-bit variable made with two 8-bit parts
0121 E4         121            clr a
0122 F530       122            mov Count1ms+0, a
0124 F531       123            mov Count1ms+1, a
0126            124            ; Enable the timer and interrupts
0126 D2AD       125       setb ET2  ; Enable timer 2 interrupt
0128 D2CA       126       setb TR2  ; Enable timer 2
012A 22         127            ret
012B            128   
012B            129   ;---------------------------------;
012B            130   ; ISR for timer 2                 ;
012B            131   ;---------------------------------;
012B            132   Timer2_ISR:
012B C2CF       133            clr TF2  ; Timer 2 doesn't clear TF2 automatically. Do it in ISR
012D B291       134            cpl P1.1 ; To check the interrupt rate with oscilloscope. It must be precisely a 1 ms pulse.
012F            135            
012F            136            ; The two registers used in the ISR must be saved in the stack
012F C0E0       137            push acc
0131 C0D0       138            push psw
0133            139            
0133            140            ; Increment the 16-bit one mili second counter
0133 0530       141            inc Count1ms+0    ; Increment the low 8-bits first
0135 E530       142            mov a, Count1ms+0 ; If the low 8-bits overflow, then increment high 8-bits
0137 7002       143            jnz Inc_Done
0139 0531       144            inc Count1ms+1
013B            145   
013B            146   Inc_Done:
013B            147            ; Check if half second has passed
013B E530       148            mov a, Count1ms+0
013D B4F41C     149            cjne a, #low(500), Timer2_ISR_done ; Warning: this instruction changes the carry flag!
0140 E531       150            mov a, Count1ms+1
0142 B40117     151            cjne a, #high(500), Timer2_ISR_done
0145            152            
0145            153            ; 500 milliseconds have passed.  Set a flag so the main program knows
0145 D200       154            setb half_seconds_flag ; Let the main program know half second had passed
0147            155            ; Toggle LEDR0 so it blinks
0147 B2E8       156            cpl LEDRA.0
0149            157            ;cpl TR0 ; Enable/disable timer/counter 0. This line creates a beep-silence-beep-silence sound.
0149            158            ; Reset to zero the milli-seconds counter, it is a 16-bit variable
0149 E4         159            clr a
014A F530       160            mov Count1ms+0, a
014C F531       161            mov Count1ms+1, a
014E            162            ; Increment the BCD counter
014E E532       163            mov a, BCD_counter
0150 20E804     164            jb UPDOWN, Timer2_ISR_decrement
0153 2401       165            add a, #0x01
0155 8002       166            sjmp Timer2_ISR_da
0157            167   Timer2_ISR_decrement:
0157 2499       168            add a, #0x99 ; Adding the 10-complement of -1 is like subtracting 1.
0159            169   Timer2_ISR_da:
0159 D4         170            da a ; Decimal adjust instruction.  Check datasheet for more details!
015A F532       171            mov BCD_counter, a
015C            172            
015C            173   Timer2_ISR_done:
015C D0D0       174            pop psw
015E D0E0       175            pop acc
0160 32         176            reti
0161            177   
0161            178   ; Look-up table for the 7-seg displays. (Segments are turn on with zero) 
0161            179   T_7seg:
0161 C0F9A4B0   180       DB 0xC0, 0xF9, 0xA4, 0xB0, 0x99        ; 0 TO 4
     99
0166 9282F880   181       DB 0x92, 0x82, 0xF8, 0x80, 0x90        ; 4 TO 9
     90
016B 8883C6A1   182       DB 0x88, 0x83, 0xC6, 0xA1, 0x86, 0x8E  ; A to F
     868E
0171            183   
0171            184   ; Displays a BCD number in HEX1-HEX0
0171            185   Display_BCD_7_Seg:
0171            186            
0171 900161     187            mov dptr, #T_7seg
0174            188   
0174 E532       189            mov a, BCD_counter
0176 C4         190            swap a
0177 540F       191            anl a, #0FH
0179 93         192            movc a, @a+dptr
017A F592       193            mov HEX1, a
017C            194            
017C E532       195            mov a, BCD_counter
017E 540F       196            anl a, #0FH
0180 93         197            movc a, @a+dptr
0181 F591       198            mov HEX0, a
0183            199            
0183 22         200            ret
0184            201   
0184            202   ;---------------------------------;
0184            203   ; Main program. Includes hardware ;
0184            204   ; initialization and 'forever'    ;
0184            205   ; loop.                           ;
0184            206   ;---------------------------------;
0184            207   
0184            208   
0184            209   playSingle_beep: 
0184 D28C       210   setb TR0
0186 C002       211            push AR2
0188 7A64       211            mov R2, #100
018A 12003B     211            lcall ?Wait_Milli_Seconds
018D D002       211            pop AR2
018F C28C       212   clr TR0
0191 C2A9       213   clr ET0
0193 C295       214   clr SOUND_OUT
0195 22         215   ret
0196            216   
0196            217   ten_beeps:
0196 790A       218   mov R1, #10
0198 1201A2     219   lcall Play_beeps
019B 22         220   ret
019C            221   
019C            222   five_beeps:
019C 7905       223   mov R1, #5
019E 1201A2     224   lcall Play_beeps
01A1 22         225   ret
01A2            226   
01A2            227   Play_beeps:
01A2 C001       228   push AR1
01A4 120184     229   lcall playSingle_beep
01A7 C002       230            push AR2
01A9 7A64       230            mov R2, #100
01AB 12003B     230            lcall ?Wait_Milli_Seconds
01AE D002       230            pop AR2
01B0 D9F0       231   djnz R1, Play_beeps
01B2 D001       232   pop AR1
01B4 22         233   ret 
01B5            234   
01B5            235   
01B5            236   main:
01B5            237            ; Initialization
01B5 75817F     238       mov SP, #0x7F
01B8 1200F8     239       lcall Timer0_Init
01BB 120112     240       lcall Timer2_Init
01BE            241       ; We use the pins of P0 to control the LCD.  Configure as outputs.
01BE 759A7F     242       mov P0MOD, #01111111b ; P0.0 to P0.6 are outputs.  ('1' makes the pin output)
01C1            243       ; We use pins P1.5 and P1.1 as outputs also.  Configure accordingly.
01C1 759B22     244       mov P1MOD, #00100010b ; P1.5 and P1.1 are outputs
01C4 759CFF     245       mov P2MOD, #0xff
01C7 759DFF     246       mov P3MOD, #0xff
01CA            247       ; Turn off all the LEDs
01CA 75E800     248       mov LEDRA, #0 ; LEDRA is bit addressable
01CD 759500     249       mov LEDRB, #0 ; LEDRB is NOT bit addresable
01D0 D2AF       250       setb EA   ; Enable Global interrupts
01D2 12008A     251       lcall ELCD_4BIT ; Configure LCD in four bit mode
01D5            252       ; For convenience a few handy macros are included in 'LCD_4bit_DE1Lite.inc':
01D5 C0E0       253            push acc
01D7 7401       253            mov a, #1
01D9 14         253            dec a
01DA 1200CC     253            lcall ?Set_Cursor_1 ; Select column and row
01DD D0E0       253            pop acc
01DF C083       254            push dph
01E1 C082       254            push dpl
01E3 C0E0       254            push acc
01E5 9000E7     254            mov dptr, #Initial_Message
01E8 1200BF     254            lcall ?Send_Constant_String
01EB D0E0       254            pop acc
01ED D082       254            pop dpl
01EF D083       254            pop dph
01F1 D200       255       setb half_seconds_flag
01F3 753200     256            mov BCD_counter, #0x00 ; Initialize counter to zero
01F6            257            
01F6            258            ; After initialization the program stays in this 'forever' loop
01F6            259   loop:
01F6            260   
01F6            261            
01F6 30E900     262            jnb Play_beeps_Switch, skip_beep
01F9            263            ;lcall playSingle_beep
01F9            264   
01F9            265   
01F9            266   skip_beep:
01F9 20F91C     267            jb KEY.1, loop_a  ; if the KEY1 button is not pressed skip
01FC C002       268            push AR2
01FE 7A32       268            mov R2, #50
0200 12003B     268            lcall ?Wait_Milli_Seconds
0203 D002       268            pop AR2         ; Debounce delay.  This macro is also in 'LCD_4bit_DE1Lite.inc'
0205 20F910     269            jb KEY.1, loop_a  ; if the KEY1 button is not pressed skip
0208 30F9FD     270            jnb KEY.1, $            ; Wait for button release.  The '$' means: jump to same instruction.
020B            271            
020B            272   
020B            273            
020B            274            ; A valid press of the 'BOOT' button has been detected, reset the BCD counter.
020B            275            ; But first stop timer 2 and reset the milli-seconds counter, to resync everything.
020B C2CA       276            clr TR2 ; Stop timer 2
020D E4         277            clr a
020E F530       278            mov Count1ms+0, a
0210 F531       279            mov Count1ms+1, a
0212            280            ; Now clear the BCD counter
0212 F532       281            mov BCD_counter, a
0214 D2CA       282            setb TR2    ; Start timer 2
0216            283   
0216 8003       284            sjmp loop_b ; Display the new value
0218            285   loop_a:
0218 3000DE     286            jnb half_seconds_flag, skip_beep
021B            287   loop_b:
021B C200       288       clr half_seconds_flag ; We clear this flag in the main loop, but it is set in the ISR for timer 2
021D C0E0       289            push acc
021F 740E       289            mov a, #14
0221 14         289            dec a
0222 1200CC     289            lcall ?Set_Cursor_1 ; Select column and row
0225 D0E0       289            pop acc     ; the place in the LCD where we want the BCD counter value
0227 C000       290            push ar0
0229 A832       290            mov r0, BCD_counter
022B 1200D1     290            lcall ?Display_BCD
022E D000       290            pop ar0 ; This macro is also in 'LCD_4bit_DE1Lite.inc'
0230 120171     291            lcall Display_BCD_7_Seg ; Also display the counter using the 7-segment displays.
0233 0201F9     292       ljmp skip_beep
0236            293   END
