0000              1   ; ISR_example_DE10Lite.asm:
0000              2   ; a) Increments/decrements a BCD variable every half second using
0000              3   ;    an ISR for timer 2.  Uses SW0 to decide.  Also 'blinks' LEDR0 every
0000              4   ;    half a second.
0000              5   ; b) Generates a 2kHz square wave at pin P1.5 using an ISR for timer 0.
0000              6   ; c) In the 'main' loop it displays the variable incremented/decremented
0000              7   ;    using the ISR for timer 2 on the LCD and the 7-segment displays.
0000              8   ;    Also resets it to zero if the KEY1 pushbutton  is pressed.
0000              9   ; d) Controls the LCD using general purpose pins P2.3, P2.5, P2.7, P3.1, P3.3, P3.5, P3.7
0000             10   ;
                 12   $LIST
0000             14   
0000             15   CLK           EQU 33333333 ; Microcontroller system crystal frequency in Hz
0000             16   TIMER0_RATE   EQU 4096     ; 2048Hz squarewave (peak amplitude of CEM-1203 speaker)
0000             17   TIMER0_RELOAD EQU ((65536-(CLK/(12*TIMER0_RATE)))) ; The prescaler in the CV-8052 is always 12 unlike the N76E003 where is selectable.
0000             18   TIMER2_RATE   EQU 1000     ; 1000Hz, for a timer tick of 1ms
0000             19   TIMER2_RELOAD EQU ((65536-(CLK/(12*TIMER2_RATE))))
0000             20   
0000             21   SOUND_OUT     equ P1.5
0000             22   UPDOWN        equ SWA.0
0000             23   Play_beeps_Switch   equ SWA.1
0000             24   
0000             25   ; Reset vector
0000             26   org 0x0000
0000 0201A8      27       ljmp main
0003             28   
0003             29   ; External interrupt 0 vector (not used in this code)
0003             30   org 0x0003
0003 32          31            reti
0004             32   
0004             33   ; Timer/Counter 0 overflow interrupt vector
000B             34   org 0x000B
000B 02010B      35            ljmp Timer0_ISR
000E             36   
000E             37   ; External interrupt 1 vector (not used in this code)
0013             38   org 0x0013
0013 32          39            reti
0014             40   
0014             41   ; Timer/Counter 1 overflow interrupt vector (not used in this code)
001B             42   org 0x001B
001B 32          43            reti
001C             44   
001C             45   ; Serial port receive/transmit interrupt vector (not used in this code)
0023             46   org 0x0023 
0023 32          47            reti
0024             48            
0024             49   ; Timer/Counter 2 overflow interrupt vector
002B             50   org 0x002B
002B 02012D      51            ljmp Timer2_ISR
002E             52   
002E             53   ; In the 8051 we can define direct access variables starting at location 0x30 up to location 0x7F
0030             54   dseg at 0x30
0030             55   Count1ms:     ds 2 ; Used to determine when half second has passed
0032             56   BCD_counter:  ds 1 ; The BCD counter incrememted in the ISR and displayed in the main loop
0033             57   beep_count: ds 1
0034             58   beep_state: ds 1
0035             59   ; In the 8051 we have variables that are 1-bit in size.  We can use the setb, clr, jb, and jnb
0035             60   ; instructions with these variables.  This is how you define a 1-bit variable:
0000             61   bseg
0000             62   half_seconds_flag: dbit 1 ; Set to one in the ISR every time 500 ms had passed
0001             63   
002E             64   cseg
002E             65   ; These 'equ' must match the wiring between the DE10Lite board and the LCD!
002E             66   ; P0 is in connector JPIO.  Check "CV-8052 Soft Processor in the DE10Lite Board: Getting
002E             67   ; Started Guide" for the details.
002E             68   ELCD_RS equ P3.7
002E             69   ELCD_RW equ P3.5
002E             70   ELCD_E  equ P3.3
002E             71   ELCD_D4 equ P3.1
002E             72   ELCD_D5 equ P2.7
002E             73   ELCD_D6 equ P2.5
002E             74   ELCD_D7 equ P2.3
                 76   	$LIST
00E7             78   
00E7             79   ;                     1234567890123456    <- This helps determine the location of the counter
00E7 4243445F    80   Initial_Message:  db 'BCD_counter: xx ', 0
     636F756E
     7465723A
     20787820
     00
00F8             81   
00F8             82   ;---------------------------------;
00F8             83   ; Routine to initialize the ISR   ;
00F8             84   ; for timer 0                     ;
00F8             85   ;---------------------------------;
00F8             86   Timer0_Init:
00F8 E589        87            mov a, TMOD
00FA 54F0        88            anl a, #0xf0 ; Clear the bits for timer 0
00FC 4401        89            orl a, #0x01 ; Configure timer 0 as 16-timer
00FE F589        90            mov TMOD, a
0100 758CFD      91            mov TH0, #high(TIMER0_RELOAD)
0103 758A5A      92            mov TL0, #low(TIMER0_RELOAD)
0106             93            ; Enable the timer and interrupts
0106 D2A9        94       setb ET0  ; Enable timer 0 interrupt
0108 C28C        95       clr TR0  ; Start timer 0
010A 22          96            ret
010B             97   
010B             98   ;---------------------------------;
010B             99   ; ISR for timer 0.  Set to execute;
010B            100   ; every 1/4096Hz to generate a    ;
010B            101   ; 2048 Hz square wave at pin P3.7 ;
010B            102   ;---------------------------------;
010B            103   Timer0_ISR:
010B            104            ;clr TF0  ; According to the data sheet this is done for us already.
010B 758CFD     105            mov TH0, #high(TIMER0_RELOAD) ; Timer 0 doesn't have autoreload in the CV-8052
010E 758A5A     106            mov TL0, #low(TIMER0_RELOAD)
0111 B295       107            cpl SOUND_OUT ; Connect speaker to P3.7!
0113 32         108            reti
0114            109   
0114            110   ;---------------------------------;
0114            111   ; Routine to initialize the ISR   ;
0114            112   ; for timer 2                     ;
0114            113   ;---------------------------------;
0114            114   Timer2_Init:
0114 75C800     115            mov T2CON, #0 ; Stop timer/counter.  Autoreload mode.
0117 75CDF5     116            mov TH2, #high(TIMER2_RELOAD)
011A 75CC27     117            mov TL2, #low(TIMER2_RELOAD)
011D            118            ; Set the reload value
011D 75CBF5     119            mov RCAP2H, #high(TIMER2_RELOAD)
0120 75CA27     120            mov RCAP2L, #low(TIMER2_RELOAD)
0123            121            ; Init One millisecond interrupt counter.  It is a 16-bit variable made with two 8-bit parts
0123 E4         122            clr a
0124 F530       123            mov Count1ms+0, a
0126 F531       124            mov Count1ms+1, a
0128            125            ; Enable the timer and interrupts
0128 D2AD       126       setb ET2  ; Enable timer 2 interrupt
012A D2CA       127       setb TR2  ; Enable timer 2
012C 22         128            ret
012D            129   
012D            130   ;---------------------------------;
012D            131   ; ISR for timer 2                 ;
012D            132   ;---------------------------------;
012D            133   Timer2_ISR:
012D C2CF       134            clr TF2  ; Timer 2 doesn't clear TF2 automatically. Do it in ISR
012F            135            ;cpl P1.1  To check the interrupt rate with oscilloscope. It must be precisely a 1 ms pulse.
012F            136            
012F            137            ; The two registers used in the ISR must be saved in the stack
012F C0E0       138            push acc
0131 C0D0       139            push psw
0133            140            
0133            141            ; Increment the 16-bit one mili second counter
0133 0530       142            inc Count1ms+0    ; Increment the low 8-bits first
0135 E530       143            mov a, Count1ms+0 ; If the low 8-bits overflow, then increment high 8-bits
0137 7002       144            jnz Inc_Done
0139 0531       145            inc Count1ms+1
013B            146            
013B            147   
013B            148   Inc_Done:
013B            149            ; Check if half second has passed
013B E530       150            mov a, Count1ms+0
013D B4F434     151            cjne a, #low(500), Timer2_ISR_done ; Warning: this instruction changes the carry flag!
0140 E531       152            mov a, Count1ms+1
0142 B4012F     153            cjne a, #high(500), Timer2_ISR_done
0145            154            
0145            155            ; 500 milliseconds have passed.  Set a flag so the main program knows
0145 D200       156            setb half_seconds_flag ; Let the main program know half second had passed
0147            157            ; Toggle LEDR0 so it blinks
0147 B2E8       158            cpl LEDRA.0
0149            159            
0149            160            
0149 E533       161            mov a, beep_count
014B 6014       162            jz no_beep
014D            163            
014D            164            
014D E534       165            mov a, beep_state
014F 600B       166            jz turn_beep_on
0151            167            
0151 C28C       168            clr TR0
0153 C295       169            clr SOUND_OUT
0155 753400     170            mov beep_state, #0
0158 1533       171            dec beep_count
015A 8005       172            sjmp no_beep
015C            173            
015C            174            turn_beep_on:
015C D28C       175            setb TR0
015E 753401     176            mov beep_state, #1
0161            177            
0161            178            no_beep:
0161            179            ;cpl TR0 ; Enable/disable timer/counter 0. This line creates a beep-silence-beep-silence sound.
0161            180            ; Reset to zero the milli-seconds counter, it is a 16-bit variable
0161 E4         181            clr a
0162 F530       182            mov Count1ms+0, a
0164 F531       183            mov Count1ms+1, a
0166            184            ; Increment the BCD counter
0166 E532       185            mov a, BCD_counter
0168 20E804     186            jb UPDOWN, Timer2_ISR_decrement
016B 2401       187            add a, #0x01
016D 8002       188            sjmp Timer2_ISR_da
016F            189   Timer2_ISR_decrement:
016F 2499       190            add a, #0x99 ; Adding the 10-complement of -1 is like subtracting 1.
0171            191   Timer2_ISR_da:
0171 D4         192            da a ; Decimal adjust instruction.  Check datasheet for more details!
0172 F532       193            mov BCD_counter, a
0174            194            
0174            195   Timer2_ISR_done:
0174 D0D0       196            pop psw
0176 D0E0       197            pop acc
0178 32         198            reti
0179            199   
0179            200   ; Look-up table for the 7-seg displays. (Segments are turn on with zero) 
0179            201   T_7seg:
0179 C0F9A4B0   202       DB 0xC0, 0xF9, 0xA4, 0xB0, 0x99        ; 0 TO 4
     99
017E 9282F880   203       DB 0x92, 0x82, 0xF8, 0x80, 0x90        ; 4 TO 9
     90
0183 8883C6A1   204       DB 0x88, 0x83, 0xC6, 0xA1, 0x86, 0x8E  ; A to F
     868E
0189            205   
0189            206   ; Displays a BCD number in HEX1-HEX0
0189            207   Display_BCD_7_Seg:
0189            208            
0189 900179     209            mov dptr, #T_7seg
018C            210   
018C E532       211            mov a, BCD_counter
018E C4         212            swap a
018F 540F       213            anl a, #0FH
0191 93         214            movc a, @a+dptr
0192 F592       215            mov HEX1, a
0194            216            
0194 E532       217            mov a, BCD_counter
0196 540F       218            anl a, #0FH
0198 93         219            movc a, @a+dptr
0199 F591       220            mov HEX0, a
019B            221            
019B 22         222            ret
019C            223   
019C            224   ;---------------------------------;
019C            225   ; Main program. Includes hardware ;
019C            226   ; initialization and 'forever'    ;
019C            227   ; loop.                           ;
019C            228   ;---------------------------------;
019C            229   
019C            230   
019C            231   playSingle_beep: 
019C 753301     232   mov beep_count, #1
019F 22         233   ret
01A0            234   
01A0            235   ten_beeps:
01A0 75330A     236   mov beep_count, #10
01A3 22         237   ret
01A4            238   
01A4            239   five_beeps:
01A4 753305     240   mov beep_count, #5
01A7 22         241   ret
01A8            242   
01A8            243   
01A8            244   
01A8            245   main:
01A8            246            ; Initialization
01A8 75817F     247       mov SP, #0x7F
01AB 1200F8     248       lcall Timer0_Init
01AE 120114     249       lcall Timer2_Init
01B1            250       ; We use the pins of P0 to control the LCD.  Configure as outputs.
01B1 759A7F     251       mov P0MOD, #01111111b ; P0.0 to P0.6 are outputs.  ('1' makes the pin output)
01B4            252       ; We use pins P1.5 and P1.1 as outputs also.  Configure accordingly.
01B4 759B22     253       mov P1MOD, #00100010b ; P1.5 and P1.1 are outputs
01B7 759CFF     254       mov P2MOD, #0xff
01BA 759DFF     255       mov P3MOD, #0xff
01BD            256       ; Turn off all the LEDs
01BD 75E800     257       mov LEDRA, #0 ; LEDRA is bit addressable
01C0 759500     258       mov LEDRB, #0 ; LEDRB is NOT bit addresable
01C3 D2AF       259       setb EA   ; Enable Global interrupts
01C5 12008A     260       lcall ELCD_4BIT ; Configure LCD in four bit mode
01C8            261       ; For convenience a few handy macros are included in 'LCD_4bit_DE1Lite.inc':
01C8 C0E0       262            push acc
01CA 7401       262            mov a, #1
01CC 14         262            dec a
01CD 1200CC     262            lcall ?Set_Cursor_1 ; Select column and row
01D0 D0E0       262            pop acc
01D2 C083       263            push dph
01D4 C082       263            push dpl
01D6 C0E0       263            push acc
01D8 9000E7     263            mov dptr, #Initial_Message
01DB 1200BF     263            lcall ?Send_Constant_String
01DE D0E0       263            pop acc
01E0 D082       263            pop dpl
01E2 D083       263            pop dph
01E4 D200       264       setb half_seconds_flag
01E6 753200     265            mov BCD_counter, #0x00 ; Initialize counter to zero
01E9 C28C       266            clr TR0
01EB C295       267            clr SOUND_OUT
01ED            268            
01ED            269            ; After initialization the program stays in this 'forever' loop
01ED            270   loop:
01ED            271   
01ED            272            
01ED 30E906     273            jnb Play_beeps_Switch, skip_beep
01F0 300003     274            jnb half_seconds_flag, skip_beep   ; wait for 500 ms tick
01F3 12019C     275            lcall playSingle_beep
01F6            276   
01F6            277   
01F6            278   skip_beep:
01F6 20F91C     279            jb KEY.1, loop_a  ; if the KEY1 button is not pressed skip
01F9 C002       280            push AR2
01FB 7A32       280            mov R2, #50
01FD 12003B     280            lcall ?Wait_Milli_Seconds
0200 D002       280            pop AR2         ; Debounce delay.  This macro is also in 'LCD_4bit_DE1Lite.inc'
0202 20F910     281            jb KEY.1, loop_a  ; if the KEY1 button is not pressed skip
0205 30F9FD     282            jnb KEY.1, $            ; Wait for button release.  The '$' means: jump to same instruction.
0208            283            
0208            284   
0208            285            
0208            286            ; A valid press of the 'BOOT' button has been detected, reset the BCD counter.
0208            287            ; But first stop timer 2 and reset the milli-seconds counter, to resync everything.
0208 C2CA       288            clr TR2 ; Stop timer 2
020A E4         289            clr a
020B F530       290            mov Count1ms+0, a
020D F531       291            mov Count1ms+1, a
020F            292            ; Now clear the BCD counter
020F F532       293            mov BCD_counter, a
0211 D2CA       294            setb TR2    ; Start timer 2
0213            295   
0213 8003       296            sjmp loop_b ; Display the new value
0215            297   loop_a:
0215 3000D5     298            jnb half_seconds_flag, loop
0218            299   loop_b:
0218 C200       300       clr half_seconds_flag ; We clear this flag in the main loop, but it is set in the ISR for timer 2
021A C0E0       301            push acc
021C 740E       301            mov a, #14
021E 14         301            dec a
021F 1200CC     301            lcall ?Set_Cursor_1 ; Select column and row
0222 D0E0       301            pop acc     ; the place in the LCD where we want the BCD counter value
0224 C000       302            push ar0
0226 A832       302            mov r0, BCD_counter
0228 1200D1     302            lcall ?Display_BCD
022B D000       302            pop ar0 ; This macro is also in 'LCD_4bit_DE1Lite.inc'
022D 120189     303            lcall Display_BCD_7_Seg ; Also display the counter using the 7-segment displays.
0230 0201ED     304       ljmp loop
0233            305   END
