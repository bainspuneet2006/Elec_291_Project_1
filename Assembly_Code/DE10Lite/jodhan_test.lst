0E3E           1672   KeyLED_LUT:
0E3E           1673       ; key 0..15 => 16-bit mask (low byte first)
0E3E 0100      1674       DB 01h,00h   ; 0  -> LEDRA.0
0E40 0200      1675       DB 02h,00h   ; 1  -> LEDRA.1
0E42 0400      1676       DB 04h,00h   ; 2  -> LEDRA.2
0E44 0800      1677       DB 08h,00h   ; 3  -> LEDRA.3
0E46 1000      1678       DB 10h,00h   ; 4  -> LEDRA.4
0E48 2000      1679       DB 20h,00h   ; 5  -> LEDRA.5
0E4A 4000      1680       DB 40h,00h   ; 6  -> LEDRA.6
0E4C 8000      1681       DB 80h,00h   ; 7  -> LEDRA.7
0E4E 0001      1682       DB 00h,01h   ; 8  -> LEDRB.0
0E50 0002      1683       DB 00h,02h   ; 9  -> LEDRB.1
0E52 0004      1684       DB 00h,04h   ; A  -> LEDRB.2
0E54 0008      1685       DB 00h,08h   ; B  -> LEDRB.3
0E56 0010      1686       DB 00h,10h   ; C  -> LEDRB.4
0E58 0020      1687       DB 00h,20h   ; D  -> LEDRB.5
0E5A 0040      1688       DB 00h,40h   ; E  -> LEDRB.6
0E5C 0080      1689       DB 00h,80h   ; F  -> LEDRB.7
