0B90           1398   
0B90           1399   ; This subroutine scans a 4x4 keypad.  If a key is pressed sets the carry
0B90           1400   ; to one and returns the key code in register R7.
0B90           1401   ; It works with both a default keypad or a modified keypad with the labels
0B90           1402   ; rotated 90 deg ccw.  The type of keypad is determined by SW0, which is bit SWA.0
0B90           1403   Keypad:
0B90           1404   ; First check the backspace/correction pushbutton.  We use KEY1 for this function.
               1404   $MESSAGE TIP: KEY1 is the erase key
0B90 20F90B    1406   jb KEY.1, keypad_L0
0B93 120B76    1407   lcall Wait25ms ; debounce
0B96 20F905    1408   jb KEY.1, keypad_L0
0B99 30F9FD    1409   jnb KEY.1, $ ; The key was pressed, wait for release
0B9C C3        1410   clr c
0B9D 22        1411   ret
0B9E           1412   
0B9E           1413   keypad_L0:
0B9E           1414   ; Make all the rows zero.  If any column is zero then a key is pressed.
0B9E C292      1415   clr ROW1
0BA0 C294      1416   clr ROW2
0BA2 C296      1417   clr ROW3
0BA4 C2A0      1418   clr ROW4
0BA6 A2A2      1419   mov c, COL1
0BA8 82A4      1420   anl c, COL2
0BAA 82A6      1421   anl c, COL3
0BAC 82B0      1422   anl c, COL4
0BAE 5002      1423   jnc Keypad_Debounce
0BB0 C3        1424   clr c
0BB1 22        1425   ret
0BB2           1426   
0BB2           1427   Keypad_Debounce:
0BB2           1428   ; A key maybe pressed.  Wait and check again to discard bounces.
0BB2 120B76    1429   lcall Wait25ms ; debounce
0BB5 A2A2      1430   mov c, COL1
0BB7 82A4      1431   anl c, COL2
0BB9 82A6      1432   anl c, COL3
0BBB 82B0      1433   anl c, COL4
0BBD 5002      1434   jnc Keypad_Key_Code
0BBF C3        1435   clr c
0BC0 22        1436   ret
0BC1           1437   
0BC1           1438   Keypad_Key_Code:
0BC1           1439   ; A key is pressed.  Find out which one by checking each possible column and row combination.
0BC1           1440   
0BC1 D292      1441   setb ROW1
0BC3 D294      1442   setb ROW2
0BC5 D296      1443   setb ROW3
0BC7 D2A0      1444   setb ROW4
0BC9           1445   
               1445   $MESSAGE TIP: SW0 is used to control the layout of the keypad. SW0=0: unmodified keypad. SW0=1: keypad rotated 90 deg CCW
0BC9           1447   
0BC9           1448   ;jnb SWA.0, keypad_default
0BC9           1449   ;ljmp keypad_90deg
