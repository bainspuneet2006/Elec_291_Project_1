050E            372   
050E            373   DEL_Print:
050E            374       ; thousands, hundreds, tens, ones using repeated subtraction
050E 7A00       375       mov R2, #0    ; thousands
0510            376   DEL_Thou_L:
0510            377       ; if < 1000 stop
0510 EB         378       mov a, R3
0511 7006       379       jnz DEL_Thou_Sub
0513 EC         380       mov a, R4
0514 C3         381       clr c
0515 94E8       382       subb a, #low(1000)
0517 400C       383       jc DEL_Thou_D
0519            384   DEL_Thou_Sub:
