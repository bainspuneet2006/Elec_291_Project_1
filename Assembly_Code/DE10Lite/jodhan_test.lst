0E62 C083      1694       push dph
0E64           1695   
0E64 120B90    1696       lcall Keypad
0E67 5016      1697       jnc KTL_no_key          ; no key -> keep LEDs as-is (or clear)
0E69           1698   
0E69           1699       ; If R7 is not 0..15, ignore
0E69 EF        1700       mov a, R7
0E6A C3        1701       clr c
0E6B 9410      1702       subb a, #10h
0E6D 5010      1703       jnc KTL_done
0E6F           1704   
0E6F           1705       ; DPTR = LUT + (R7*2)
0E6F 900E3E    1706       mov dptr, #KeyLED_LUT
0E72 EF        1707       mov a, R7
0E73 23        1708       rl a               ; *2
0E74 93        1709       movc a, @a+dptr         ; low byte
0E75 F5E8      1710       mov LEDRA, a
0E77 EF        1711       mov a, R7
0E78 23        1712       rl a
0E79 04        1713       inc a
0E7A 93        1714       movc a, @a+dptr         ; high byte
0E7B F595      1715       mov LEDRB, a
0E7D 8000      1716       sjmp KTL_done
0E7F           1717   
0E7F           1718   KTL_no_key:
0E7F           1719       ; optional: clear LEDs when no key
0E7F           1720       ; mov LEDRA, #0
0E7F           1721       ; mov LEDRB, #0
0E7F           1722   
0E7F           1723   KTL_done:
0E7F D083      1724       pop dph
0E81 D082      1725       pop dpl
0E83 D0E0      1726       pop acc
