04FA            355   
04FA            356       ; Cap at 9999 for display safety
04FA            357       ; if R3:R4 > 9999 then force 9999
04FA EB         358       mov a, R3
04FB C3         359       clr c
04FC 9427       360       subb a, #high(9999)
04FE 400E       361       jc DEL_Print
0500 7008       362       jnz DEL_Force9999
0502 EC         363       mov a, R4
0503 C3         364       clr c
