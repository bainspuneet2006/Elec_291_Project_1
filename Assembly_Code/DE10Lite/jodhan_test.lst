0519 EC         386       mov a, R4
051A C3         387       clr c
051B 94E8       388       subb a, #low(1000)
051D FC         389       mov R4, a
051E EB         390       mov a, R3
051F 9403       391       subb a, #high(1000)
0521 FB         392       mov R3, a
0522 0A         393       inc R2
0523 80EB       394       sjmp DEL_Thou_L
