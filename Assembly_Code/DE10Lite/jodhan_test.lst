0D2D           1530   Get3Digits:
0D2D C3        1531       clr c
0D2E C0E0      1532       push acc
0D30 C0F0      1533       push b
0D32 C0D0      1534       push psw
0D34           1535   
0D34 120B90    1536       lcall Keypad
0D37 503C      1537       jnc G3_no_key
0D39           1538   
0D39           1539       ; Key pressed (code in R7)
0D39           1540   
0D39           1541       ; CHECK FOR 'ENTER' (e.g. # key which is 0x0F or 0x0D depending on map)
0D39           1542       ; Assuming keypad_default maps ROW4/COL4 to 0x0D (#) or similar.
0D39           1543       ; Check your Keypad_Key_Code routine.
0D39           1544       ; K_R4_C4 -> #0DH. So if R7 == 0x0D, it's enter.
0D39           1545   
0D39 EF        1546       mov a, R7
0D3A B40D0C    1547       cjne a, #0DH, G3_check_digit
0D3D           1548       ; ENTER PRESSED
0D3D           1549       ; If we have at least 1 digit, accept it
0D3D E560      1550       mov a, edit_digits
0D3F 603C      1551       jz G3_exit ; ignore empty enter
0D41           1552   
0D41 D0D0      1553       pop psw ; Restore PSW (carry=0)
0D43 D3        1554       setb c  ; Set carry = 1 (DONE)
0D44 D0F0      1555       pop b
0D46 D0E0      1556       pop acc
0D48 22        1557       ret
0D49           1558   
0D49           1559   G3_check_digit:
0D49           1560       ; Accept only 0..9
0D49 EF        1561       mov a, R7
0D4A C3        1562       clr c
0D4B 940A      1563       subb a, #0Ah
0D4D 502E      1564       jnc G3_exit            
0D4F           1565   
0D4F           1566       ; Check overflow (3 digits max)
0D4F E560      1567       mov a, edit_digits
0D51 B40302    1568       cjne a, #3, G3_build
0D54 8027      1569       sjmp G3_exit
0D56           1570   
0D56           1571   G3_build:
0D56           1572       ; val = val*10 + new
0D56 E55F      1573       mov a, edit_value
0D58 255F      1574       add a, edit_value      
0D5A F5F0      1575       mov b, a                
0D5C E55F      1576       mov a, edit_value
0D5E 23        1577       rl a
0D5F 23        1578       rl a
0D60 23        1579       rl a                    
0D61 25F0      1580       add a, b                
0D63 2F        1581       add a, R7              
0D64           1582   
0D64 F55F      1583       mov edit_value, a
0D66 0560      1584       inc edit_digits
0D68           1585   
0D68           1586       ; If 3 digits reached, done automatically
0D68 E560      1587       mov a, edit_digits
0D6A B40310    1588       cjne a, #3, G3_exit
0D6D           1589   
0D6D           1590       ; DONE (3 digits)
0D6D D0D0      1591       pop psw  ; Restore PSW (Carry=0)
0D6F D3        1592       setb c   ; Force Carry=1
0D70 D0F0      1593       pop b
0D72 D0E0      1594       pop acc
0D74 22        1595       ret
