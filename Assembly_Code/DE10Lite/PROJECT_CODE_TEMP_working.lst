08C4 C0F9A4B0  1160       DB 0xC0, 0xF9, 0xA4, 0xB0, 0x99        ; 0 TO 4
     99
08C9 9282F880  1161       DB 0x92, 0x82, 0xF8, 0x80, 0x90        ; 4 TO 9
     90
08CE 8883C6A1  1162       DB 0x88, 0x83, 0xC6, 0xA1, 0x86, 0x8E  ; A to F
     868E
08D4           1163   
               1164   showBCD MAC
               1165   	; Display LSD
               1166       mov A, %0
               1167       anl a, #0fh
               1168       movc A, @A+dptr
               1169       mov %1, A
               1170   	; Display MSD
               1171       mov A, %0
               1172       swap a
               1173       anl a, #0fh
               1174       movc A, @A+dptr
               1175       mov %2, A
               1176   ENDMAC
08D4           1177   
08D4           1178   
08D4           1179   
               1180   MYRLC MAC
               1181   	mov a, %0
               1182   	rlc a
               1183   	mov %0, a
               1184   ENDMAC
08D4           1185   
08D4           1186   
               1187   MYRRC MAC
               1188   	mov a, %0
               1189   	rrc a
               1190   	mov %0, a
               1191   ENDMAC
08D4           1192   
08D4           1193   
08D4           1194   
08D4           1195   Wait25ms:
08D4           1196   ;33.33MHz, 1 clk per cycle: 0.03us
08D4 780F      1197            mov R0, #15
08D6           1198   L33: 
08D6 794A      1199   mov R1, #74
08D8           1200   L22: 
08D8 7AFA      1201   mov R2, #250
08DA           1202   L11: 
08DA DAFE      1203   djnz R2, L11 ;3*250*0.03us=22.5us
08DC D9FA      1204       djnz R1, L22 ;74*22.5us=1.665ms
08DE D8F6      1205       djnz R0, L33 ;1.665ms*15=25ms
08E0 22        1206       ret
08E1           1207   
               1208   CHECK_COLUMN MAC
               1209   	jb %0, CHECK_COL_%M
               1210   	mov R7, %1
               1211   	jnb %0, $ ; wait for key release
               1212   	setb c
               1213   	ret
               1214   CHECK_COL_%M:
               1215   ENDMAC
