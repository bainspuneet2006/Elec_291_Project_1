0B5B           1294   ;--------------------------------------------
0B5B           1295   ; this is how we pick to edit the parameters
0B5B           1296   ;--------------------------------------------
0B5B           1297   
0B5B           1298   Get3Digits:
0B5B C3        1299       clr c
0B5C C0E0      1300       push acc
0B5E C0F0      1301       push b
0B60 C0D0      1302       push psw
0B62           1303   
0B62 1209BE    1304       lcall Keypad
0B65 503C      1305       jnc G3_no_key
0B67           1306   
0B67           1307       ; Key pressed (code in R7)
0B67           1308   
0B67           1309       ; CHECK FOR 'ENTER' (e.g. # key which is 0x0F or 0x0D depending on map)
0B67           1310       ; Assuming keypad_default maps ROW4/COL4 to 0x0D (#) or similar.
0B67           1311       ; Check your Keypad_Key_Code routine.
0B67           1312       ; K_R4_C4 -> #0DH. So if R7 == 0x0D, it's enter.
0B67           1313   
0B67 EF        1314       mov a, R7
0B68 B40D0C    1315       cjne a, #0DH, G3_check_digit
0B6B           1316       ; ENTER PRESSED
0B6B           1317       ; If we have at least 1 digit, accept it
0B6B E55F      1318       mov a, edit_digits
0B6D 603C      1319       jz G3_exit ; ignore empty enter
0B6F           1320   
0B6F D0D0      1321       pop psw ; Restore PSW (carry=0)
0B71 D3        1322       setb c  ; Set carry = 1 (DONE)
0B72 D0F0      1323       pop b
0B74 D0E0      1324       pop acc
0B76 22        1325       ret
0B77           1326   
0B77           1327   G3_check_digit:
0B77           1328       ; Accept only 0..9
0B77 EF        1329       mov a, R7
0B78 C3        1330       clr c
0B79 940A      1331       subb a, #0Ah
0B7B 502E      1332       jnc G3_exit             
0B7D           1333   
0B7D           1334       ; Check overflow (3 digits max)
0B7D E55F      1335       mov a, edit_digits
0B7F B40302    1336       cjne a, #3, G3_build
0B82 8027      1337       sjmp G3_exit
0B84           1338   
0B84           1339   G3_build:
0B84           1340       ; val = val*10 + new
0B84 E55E      1341       mov a, edit_value
0B86 255E      1342       add a, edit_value       
0B88 F5F0      1343       mov b, a                 
0B8A E55E      1344       mov a, edit_value
0B8C 23        1345       rl a
0B8D 23        1346       rl a
0B8E 23        1347       rl a                     
0B8F 25F0      1348       add a, b                 
0B91 2F        1349       add a, R7               
0B92           1350   
0B92 F55E      1351       mov edit_value, a
0B94 055F      1352       inc edit_digits
0B96           1353   
0B96           1354       ; If 3 digits reached, done automatically
0B96 E55F      1355       mov a, edit_digits
0B98 B40310    1356       cjne a, #3, G3_exit
0B9B           1357   
0B9B           1358       ; DONE (3 digits)
0B9B D0D0      1359       pop psw  ; Restore PSW (Carry=0)
0B9D D3        1360       setb c   ; Force Carry=1
0B9E D0F0      1361       pop b
0BA0 D0E0      1362       pop acc
0BA2 22        1363       ret
0BA3           1364   
0BA3           1365   G3_no_key:
0BA3 D0D0      1366       pop psw ; Restore PSW (Carry=0)
0BA5 C3        1367       clr c   ; Ensure Carry=0
0BA6 D0F0      1368       pop b
0BA8 D0E0      1369       pop acc
0BAA 22        1370       ret
0BAB           1371   
0BAB           1372   G3_exit:
0BAB D0D0      1373       pop psw
0BAD C3        1374       clr c
0BAE D0F0      1375       pop b
0BB0 D0E0      1376       pop acc
0BB2 22        1377       ret
0BB3           1378   
0BB3           1379   ReadParamSel_SW01:
0BB3 C0E0      1380       push acc
