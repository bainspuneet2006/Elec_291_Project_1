06DC            821   
06DC            822   PU32_loop:
06DC 75440A     823            mov y+0, #low (10 % 0x10000) 
06DF 754500     823            mov y+1, #high(10 % 0x10000) 
06E2 754600     823            mov y+2, #low (10 / 0x10000) 
06E5 754700     823            mov y+3, #high(10 / 0x10000) 
06E8 1202FE     824       lcall div32         ; x = x/10, remainder in y (0..9)
06EB            825   
06EB E544       826       mov a, y+0
06ED 2430       827       add a, #'0'         ; remainder -> ASCII digit
06EF C0E0       828       push acc
06F1 0F         829       inc R7
06F2            830   
06F2 E540       831       mov a, x+0
06F4 4541       832       orl a, x+1
06F6 4542       833       orl a, x+2
06F8 4543       834       orl a, x+3
06FA 70E0       835       jnz PU32_loop
06FC            836   
06FC            837   PU32_pop:
06FC D0E0       838       pop acc
06FE 1206AB     839       lcall putchar
0701 DFF9       840       djnz R7, PU32_pop
0703 22         841       ret
