057F 75390A     544            mov y+0, #low (10 % 0x10000) 
0582 753A00     544            mov y+1, #high(10 % 0x10000) 
0585 753B00     544            mov y+2, #low (10 / 0x10000) 
0588 753C00     544            mov y+3, #high(10 / 0x10000) 
058B 1202FE     545       lcall div32         ; x = x/10, remainder in y (0..9)
058E            546   
058E E539       547       mov a, y+0
0590 2430       548       add a, #'0'         ; remainder -> ASCII digit
0592 C0E0       549       push acc
0594 0F         550       inc R7
0595            551   
0595 E535       552       mov a, x+0
0597 4536       553       orl a, x+1
0599 4537       554       orl a, x+2
059B 4538       555       orl a, x+3
059D 70E0       556       jnz PU32_loop
059F            557   
