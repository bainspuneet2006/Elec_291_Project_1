               1062   showBCD MAC
               1063   ; Display LSD
               1064       mov A, %0
               1065       anl a, #0fh
               1066       movc A, @A+dptr
               1067       mov %1, A
               1068   ; Display MSD
               1069       mov A, %0
               1070       swap a
               1071       anl a, #0fh
               1072       movc A, @A+dptr
               1073       mov %2, A
               1074   ENDMAC
0979           1075   
