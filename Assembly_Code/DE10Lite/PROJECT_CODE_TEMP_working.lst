049E            328   ; NEW: Show elapsed time on LCD (row1 col13..16) if state != 0
049E            329   ; Displays elapsed seconds as 4 digits, saturates at 9999.
049E            330   ; ==========================================================
049E            331   Display_Elapsed_LCD:
049E C0E0       332       push acc
04A0 C0F0       333       push b
04A2 C0D0       334       push psw
04A4            335   
04A4            336       ; Only show if not state 0
04A4 E537       337       mov a, FSM1_state
04A6 6072       338       jz DEL_Clear
04A8            339   
04A8            340       ; Copy elapsed_sec to R3:R4 (16-bit)
04A8 AC40       341       mov R4, elapsed_sec+0
04AA AB41       342       mov R3, elapsed_sec+1
04AC            343   
04AC            344       ; Cap at 9999 for display safety
04AC            345       ; if R3:R4 > 9999 then force 9999
04AC EB         346       mov a, R3
04AD C3         347       clr c
04AE 9427       348       subb a, #high(9999)
04B0 400E       349       jc DEL_Print
04B2 7008       350       jnz DEL_Force9999
04B4 EC         351       mov a, R4
04B5 C3         352       clr c
04B6 940F       353       subb a, #low(9999)
04B8 5002       354       jnc DEL_Force9999
04BA 8004       355       sjmp DEL_Print
04BC            356   
04BC            357   DEL_Force9999:
04BC 7B27       358       mov R3, #high(9999)
04BE 7C0F       359       mov R4, #low(9999)
04C0            360   
04C0            361   DEL_Print:
04C0            362       ; thousands, hundreds, tens, ones using repeated subtraction
04C0 7A00       363       mov R2, #0    ; thousands
04C2            364   DEL_Thou_L:
04C2            365       ; if < 1000 stop
04C2 EB         366       mov a, R3
04C3 7006       367       jnz DEL_Thou_Sub
04C5 EC         368       mov a, R4
04C6 C3         369       clr c
04C7 94E8       370       subb a, #low(1000)
04C9 400C       371       jc DEL_Thou_D
04CB            372   DEL_Thou_Sub:
04CB            373       ; (R3:R4) -= 1000
04CB EC         374       mov a, R4
04CC C3         375       clr c
04CD 94E8       376       subb a, #low(1000)
04CF FC         377       mov R4, a
04D0 EB         378       mov a, R3
04D1 9403       379       subb a, #high(1000)
04D3 FB         380       mov R3, a
04D4 0A         381       inc R2
04D5 80EB       382       sjmp DEL_Thou_L
04D7            383   DEL_Thou_D:
04D7            384   
04D7 7900       385       mov R1, #0    ; hundreds
04D9            386   DEL_Hund_L:
04D9            387       ; if < 100 stop
04D9 EB         388       mov a, R3
04DA 7006       389       jnz DEL_Hund_Sub
04DC EC         390       mov a, R4
04DD C3         391       clr c
04DE 9464       392       subb a, #100
04E0 400C       393       jc DEL_Hund_D
04E2            394   DEL_Hund_Sub:
04E2 EC         395       mov a, R4
04E3 C3         396       clr c
04E4 9464       397       subb a, #100
04E6 FC         398       mov R4, a
04E7 EB         399       mov a, R3
04E8 9400       400       subb a, #0
04EA FB         401       mov R3, a
04EB 09         402       inc R1
04EC 80EB       403       sjmp DEL_Hund_L
04EE            404   DEL_Hund_D:
