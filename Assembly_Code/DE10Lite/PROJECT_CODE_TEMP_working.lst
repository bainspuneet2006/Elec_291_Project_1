05E4 75F00A     613       mov b, #10
05E7 84         614       div ab              ; A=tens, B=ones
05E8            615   
05E8 2430       616       add a, #'0'
05EA 12054E     617       lcall putchar
05ED E5F0       618       mov a, b
05EF 2430       619       add a, #'0'
