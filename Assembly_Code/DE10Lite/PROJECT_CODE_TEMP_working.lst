085A           1075   ; LCD_Print3Dec
085A           1076   LCD_Print3Dec:
085A C0E0      1077       push acc
085C C0F0      1078       push b
085E C0D0      1079       push psw
0860           1080   
0860 75F064    1081       mov b, #100
0863 84        1082       div ab              ; A=hundreds, B=remainder
0864 2430      1083       add a, #'0'
0866 120092    1084       lcall ?WriteData
0869           1085   
0869 E5F0      1086       mov a, b
086B 75F00A    1087       mov b, #10
086E 84        1088       div ab              ; A=tens, B=ones
086F 2430      1089       add a, #'0'
0871 120092    1090       lcall ?WriteData
0874           1091   
0874 E5F0      1092       mov a, b
0876 2430      1093       add a, #'0'
0878 120092    1094       lcall ?WriteData
087B           1095   
087B D0D0      1096       pop psw
087D D0F0      1097       pop b
087F D0E0      1098       pop acc
0881 22        1099       ret
