08EE           1235   ; This subroutine scans a 4x4 keypad.  If a key is pressed sets the carry
08EE           1236   ; to one and returns the key code in register R7.
08EE           1237   ; It works with both a default keypad or a modified keypad with the labels
08EE           1238   ; rotated 90 deg ccw.  The type of keypad is determined by SW0, which is bit SWA.0
08EE           1239   Keypad:
08EE           1240            ; First check the backspace/correction pushbutton.  We use KEY1 for this function.
               1240   	$MESSAGE TIP: KEY1 is the erase key
08EE 20F90B    1242            jb KEY.1, keypad_L0
08F1 1208D4    1243            lcall Wait25ms ; debounce
08F4 20F905    1244            jb KEY.1, keypad_L0
08F7 30F9FD    1245            jnb KEY.1, $ ; The key was pressed, wait for release
08FA C3        1246            clr c
08FB 22        1247            ret
08FC           1248            
08FC           1249   keypad_L0:
08FC           1250            ; Make all the rows zero.  If any column is zero then a key is pressed.
08FC C292      1251            clr ROW1
08FE C294      1252            clr ROW2
0900 C296      1253            clr ROW3
0902 C2A0      1254            clr ROW4
0904 A2A2      1255            mov c, COL1
0906 82A4      1256            anl c, COL2
0908 82A6      1257            anl c, COL3
090A 82B0      1258            anl c, COL4
090C 5002      1259            jnc Keypad_Debounce
090E C3        1260            clr c
090F 22        1261            ret
0910           1262                    
0910           1263   Keypad_Debounce:
0910           1264            ; A key maybe pressed.  Wait and check again to discard bounces.
0910 1208D4    1265            lcall Wait25ms ; debounce
0913 A2A2      1266            mov c, COL1
0915 82A4      1267            anl c, COL2
0917 82A6      1268            anl c, COL3
0919 82B0      1269            anl c, COL4
091B 5002      1270            jnc Keypad_Key_Code
091D C3        1271            clr c
091E 22        1272            ret
091F           1273            
091F           1274   Keypad_Key_Code:         
091F           1275            ; A key is pressed.  Find out which one by checking each possible column and row combination.
091F           1276   
091F D292      1277            setb ROW1
0921 D294      1278            setb ROW2
0923 D296      1279            setb ROW3
0925 D2A0      1280            setb ROW4
0927           1281            
               1281   	$MESSAGE TIP: SW0 is used to control the layout of the keypad. SW0=0: unmodified keypad. SW0=1: keypad rotated 90 deg CCW
0927           1283   
