0391            161   ; Routine to initialize the ISR   ;
0391            162   ; for timer 0                     ;
0391            163   ;---------------------------------;
0391            164   Timer0_Init:
0391 E589       165            mov a, TMOD
0393 54F0       166            anl a, #0xf0 ; Clear the bits for timer 0
0395 4401       167            orl a, #0x01 ; Configure timer 0 as 16-timer
0397 F589       168            mov TMOD, a
0399 758CFD     169            mov TH0, #high(TIMER0_RELOAD)
039C 758A5A     170            mov TL0, #low(TIMER0_RELOAD)
039F            171            ; Enable the timer and interrupts
039F D2A9       172       setb ET0  ; Enable timer 0 interrupt
03A1 C28C       173       clr TR0  ; Start timer 0
03A3 22         174            ret
03A4            175   
03A4            176   ;---------------------------------;
03A4            177   ; ISR for timer 0.  Set to execute;
03A4            178   ; every 1/4096Hz to generate a    ;
03A4            179   ; 2048 Hz square wave at pin P3.7 ;
03A4            180   ;---------------------------------;
03A4            181   Timer0_ISR:
03A4            182            ;clr TF0  ; According to the data sheet this is done for us already.
03A4 758CFD     183            mov TH0, #high(TIMER0_RELOAD) ; Timer 0 doesn't have autoreload in the CV-8052
03A7 758A5A     184            mov TL0, #low(TIMER0_RELOAD)
03AA B295       185            cpl SOUND_OUT ; Connect speaker to P3.7!
03AC 32         186            reti
03AD            187   
03AD            188   
03AD            189   ;---------------------------------;
03AD            190   ; Routine to initialize the ISR   ;
03AD            191   ; for timer 2                     ;
03AD            192   ;---------------------------------;
03AD            193   Timer2_Init:
03AD 75C800     194            mov T2CON, #0 ; Stop timer/counter.  Autoreload mode.
03B0 75CDF5     195            mov TH2, #high(TIMER2_RELOAD)
03B3 75CC27     196            mov TL2, #low(TIMER2_RELOAD)
03B6            197            ; Set the reload value
03B6 75CBF5     198            mov RCAP2H, #high(TIMER2_RELOAD)
03B9 75CA27     199            mov RCAP2L, #low(TIMER2_RELOAD)
03BC            200            ; Init One millisecond interrupt counter.  It is a 16-bit variable made with two 8-bit parts
03BC E4         201            clr a
03BD F530       202            mov Count1ms+0, a
03BF F531       203            mov Count1ms+1, a
03C1            204            ; Enable the timer and interrupts
03C1 D2AD       205       setb ET2  ; Enable timer 2 interrupt
03C3 D2CA       206       setb TR2  ; Enable timer 2
03C5 22         207            ret
