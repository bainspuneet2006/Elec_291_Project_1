0B7B D0F0      1334       pop b
0B7D D0E0      1335       pop acc
0B7F 22        1336       ret
0B80           1337   
0B80           1338   G3_exit:
0B80 D0D0      1339       pop psw
0B82 C3        1340       clr c
0B83 D0F0      1341       pop b
0B85 D0E0      1342       pop acc
0B87 22        1343       ret
