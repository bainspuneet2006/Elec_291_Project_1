0882           1101   ; -------------------------------------------------
0882           1102   ; UpdateTempAvg
0882           1103   ; Input:  temp = newest integer °C sample (0..255)
0882           1104   ; Output: temp_avg = average of last up-to-10 samples
0882           1105   ; Uses:   temp_buf[10], temp_idx, temp_sum(16b), temp_count
0882           1106   ; -------------------------------------------------
0882           1107   UpdateTempAvg_Cumulative:
0882 C0E0      1108       push acc
0884 C0D0      1109       push psw
0886           1110   
0886           1111       ; ---- if count == 255, stop accumulating (freeze avg) ----
0886 E55E      1112       mov a, temp_count
0888 B4FF02    1113       cjne a, #255, UTAc_ok
088B 8032      1114       sjmp UTAc_done
088D           1115   
088D           1116   UTAc_ok:
088D           1117       ; ---- sum += temp (24-bit add) ----
088D E55B      1118       mov a, temp_sum24+0
088F 253E      1119       add a, temp
0891 F55B      1120       mov temp_sum24+0, a
0893           1121   
0893 E55C      1122       mov a, temp_sum24+1
0895 3400      1123       addc a, #0
0897 F55C      1124       mov temp_sum24+1, a
0899           1125   
0899 E55D      1126       mov a, temp_sum24+2
089B 3400      1127       addc a, #0
089D F55D      1128       mov temp_sum24+2, a
089F           1129   
089F           1130       ; ---- count++ ----
089F 055E      1131       inc temp_count
08A1           1132   
08A1           1133       ; ---- avg = sum / count using div32 ----
08A1           1134       ; x = sum (24-bit -> 32-bit)
08A1 855B40    1135       mov x+0, temp_sum24+0
08A4 855C41    1136       mov x+1, temp_sum24+1
08A7 855D42    1137       mov x+2, temp_sum24+2
08AA 754300    1138       mov x+3, #0
08AD           1139   
08AD           1140       ; y = count (8-bit -> 32-bit)
08AD 855E44    1141       mov y+0, temp_count
08B0 754500    1142       mov y+1, #0
08B3 754600    1143       mov y+2, #0
08B6 754700    1144       mov y+3, #0
08B9           1145   
08B9 1202FE    1146       lcall div32          ; x = x / y  (quotient in x)
08BC           1147   
08BC 85405F    1148       mov temp_avg, x+0    ; integer avg (0..255-ish)
08BF           1149   
08BF           1150   UTAc_done:
08BF D0D0      1151       pop psw
08C1 D0E0      1152       pop acc
08C3 22        1153       ret
08C4           1154   
