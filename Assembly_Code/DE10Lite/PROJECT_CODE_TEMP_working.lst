0993           1133   ; This subroutine scans a 4x4 keypad.  If a key is pressed sets the carry
0993           1134   ; to one and returns the key code in register R7.
0993           1135   ; It works with both a default keypad or a modified keypad with the labels
0993           1136   ; rotated 90 deg ccw.  The type of keypad is determined by SW0, which is bit SWA.0
0993           1137   Keypad:
0993           1138   ; First check the backspace/correction pushbutton.  We use KEY1 for this function.
               1138   $MESSAGE TIP: KEY1 is the erase key
0993 20F90B    1140   jb KEY.1, keypad_L0
0996 120979    1141   lcall Wait25ms ; debounce
0999 20F905    1142   jb KEY.1, keypad_L0
099C 30F9FD    1143   jnb KEY.1, $ ; The key was pressed, wait for release
099F C3        1144   clr c
09A0 22        1145   ret
09A1           1146   
09A1           1147   keypad_L0:
09A1           1148   ; Make all the rows zero.  If any column is zero then a key is pressed.
09A1 C292      1149   clr ROW1
09A3 C294      1150   clr ROW2
09A5 C296      1151   clr ROW3
09A7 C2A0      1152   clr ROW4
09A9 A2A2      1153   mov c, COL1
09AB 82A4      1154   anl c, COL2
09AD 82A6      1155   anl c, COL3
09AF 82B0      1156   anl c, COL4
09B1 5002      1157   jnc Keypad_Debounce
09B3 C3        1158   clr c
09B4 22        1159   ret
09B5           1160   
09B5           1161   Keypad_Debounce:
09B5           1162   ; A key maybe pressed.  Wait and check again to discard bounces.
09B5 120979    1163   lcall Wait25ms ; debounce
09B8 A2A2      1164   mov c, COL1
09BA 82A4      1165   anl c, COL2
09BC 82A6      1166   anl c, COL3
09BE 82B0      1167   anl c, COL4
09C0 5002      1168   jnc Keypad_Key_Code
09C2 C3        1169   clr c
09C3 22        1170   ret
09C4           1171   
09C4           1172   Keypad_Key_Code:
09C4           1173   ; A key is pressed.  Find out which one by checking each possible column and row combination.
09C4           1174   
09C4 D292      1175   setb ROW1
09C6 D294      1176   setb ROW2
09C8 D296      1177   setb ROW3
09CA D2A0      1178   setb ROW4
09CC           1179   
               1179   $MESSAGE TIP: SW0 is used to control the layout of the keypad. SW0=0: unmodified keypad. SW0=1: keypad rotated 90 deg CCW
