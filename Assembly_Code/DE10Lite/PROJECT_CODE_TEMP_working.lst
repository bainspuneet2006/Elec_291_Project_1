0979           1090   
0979           1091   
0979           1092   
0979           1093   Wait25ms:
0979           1094   ;33.33MHz, 1 clk per cycle: 0.03us
0979 780F      1095   mov R0, #15
097B           1096   L33:
097B 794A      1097   mov R1, #74
097D           1098   L22:
097D 7AFA      1099   mov R2, #250
097F           1100   L11:
097F DAFE      1101   djnz R2, L11 ;3*250*0.03us=22.5us
0981 D9FA      1102       djnz R1, L22 ;74*22.5us=1.665ms
0983 D8F6      1103       djnz R0, L33 ;1.665ms*15=25ms
0985 22        1104       ret
