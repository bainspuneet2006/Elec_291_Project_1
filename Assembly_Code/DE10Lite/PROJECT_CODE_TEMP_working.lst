05B3            571   
05B3            572       ; x = x / 100  -> integer degrees C
05B3 753964     573            mov y+0, #low (100 % 0x10000) 
05B6 753A00     573            mov y+1, #high(100 % 0x10000) 
05B9 753B00     573            mov y+2, #low (100 / 0x10000) 
05BC 753C00     573            mov y+3, #high(100 / 0x10000) 
05BF 1202FE     574       lcall div32          ; x now = integer °C (0..300-ish)
05C2            575   
05C2            576       ; --- print as exactly 3 digits: H T O ---
05C2            577       ; R3:R4 = x (16-bit is enough here)
05C2 AC35       578       mov R4, x+0
05C4 AB36       579       mov R3, x+1
05C6            580   
05C6            581       ; hundreds in R2
05C6 7A00       582       mov R2, #0
05C8            583   
05C8            584   Hund_loop:
05C8            585       ; if (R3:R4) < 100 stop
05C8 EB         586       mov a, R3
05C9 7006       587       jnz Hund_sub
05CB EC         588       mov a, R4
05CC C3         589       clr c
05CD 9464       590       subb a, #100
05CF 400C       591       jc  Hund_done
05D1            592   
05D1            593   Hund_sub:
05D1            594       ; (R3:R4) -= 100
05D1 EC         595       mov a, R4
05D2 C3         596       clr c
05D3 9464       597       subb a, #100
05D5 FC         598       mov R4, a
05D6 EB         599       mov a, R3
05D7 9400       600       subb a, #0
05D9 FB         601       mov R3, a
05DA 0A         602       inc R2
05DB 80EB       603       sjmp Hund_loop
05DD            604   
05DD            605   Hund_done:
05DD            606       ; print hundreds
05DD EA         607       mov a, R2
05DE 2430       608       add a, #'0'
05E0 12054E     609       lcall putchar
05E3            610   
05E3            611       ; print tens and ones from remaining 0..99 in R4
