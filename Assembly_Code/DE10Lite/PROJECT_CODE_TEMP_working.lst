0BA4           1342   Get3Digits:
0BA4 C3        1343       clr c
0BA5 C0E0      1344       push acc
0BA7 C0F0      1345       push b
0BA9 C0D0      1346       push psw
0BAB           1347   
0BAB 120A07    1348       lcall Keypad
0BAE 503C      1349       jnc G3_no_key
0BB0           1350   
0BB0           1351       ; Key pressed (code in R7)
0BB0           1352   
0BB0           1353       ; CHECK FOR 'ENTER' (e.g. # key which is 0x0F or 0x0D depending on map)
0BB0           1354       ; Assuming keypad_default maps ROW4/COL4 to 0x0D (#) or similar.
0BB0           1355       ; Check your Keypad_Key_Code routine.
0BB0           1356       ; K_R4_C4 -> #0DH. So if R7 == 0x0D, it's enter.
0BB0           1357   
0BB0 EF        1358       mov a, R7
0BB1 B40D0C    1359       cjne a, #0DH, G3_check_digit
0BB4           1360       ; ENTER PRESSED
0BB4           1361       ; If we have at least 1 digit, accept it
0BB4 E55F      1362       mov a, edit_digits
0BB6 603C      1363       jz G3_exit ; ignore empty enter
0BB8           1364   
0BB8 D0D0      1365       pop psw ; Restore PSW (carry=0)
0BBA D3        1366       setb c  ; Set carry = 1 (DONE)
0BBB D0F0      1367       pop b
0BBD D0E0      1368       pop acc
0BBF 22        1369       ret
0BC0           1370   
0BC0           1371   G3_check_digit:
0BC0           1372       ; Accept only 0..9
0BC0 EF        1373       mov a, R7
0BC1 C3        1374       clr c
0BC2 940A      1375       subb a, #0Ah
