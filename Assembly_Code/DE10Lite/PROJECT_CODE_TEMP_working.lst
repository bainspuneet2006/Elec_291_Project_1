0C41           1406   KeyLED_LUT:
0C41           1407       ; key 0..15 => 16-bit mask (low byte first)
0C41 0100      1408       DB 01h,00h   ; 0  -> LEDRA.0
0C43 0200      1409       DB 02h,00h   ; 1  -> LEDRA.1
0C45 0400      1410       DB 04h,00h   ; 2  -> LEDRA.2
