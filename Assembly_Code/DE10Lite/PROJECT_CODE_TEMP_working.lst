0606            638   ;---------------------------------
0606            639   ; Read_Ref
0606            640   ; Reads LM4040 reference on ADC channel 0
0606            641   ; Stores 16-bit ADC count in VAL_LM4040 (low,high)
0606            642   ;---------------------------------
0606            643   Read_Ref:
0606 7400       644       mov a, #00h            ; ADC channel 0 (AIN0)
0608 1205FF     645       lcall Read_ADC
060B 8852       646       mov VAL_LM4040+0, R0
060D 8953       647       mov VAL_LM4040+1, R1
060F 22         648       ret
0610            649   
0610            650   
0610            651   ;---------------------------------
0610            652   ; Read_op_amp_mv
0610            653   ; Reads op-amp output on ADC channel 1 (you set #01h)
0610            654   ; Computes V_amp_mv in TRUE mV:
0610            655   ;   Vopamp_mV = ADC_opamp * 4096 / ADC_ref
0610            656   ; Stores result as 32-bit in V_amp_mv
0610            657   ;---------------------------------
0610            658   Read_op_amp_mv:
0610            659       ; if reference reading is 0, avoid divide-by-zero
0610 E552       660       mov A, VAL_LM4040+0
0612 4553       661       orl A, VAL_LM4040+1
0614 700D       662       jnz _ref_ok
0616            663   
0616            664       ; V_amp_mv = 0
0616 754200     665       mov V_amp_mv+0, #00h
0619 754300     666       mov V_amp_mv+1, #00h
061C 754400     667       mov V_amp_mv+2, #00h
061F 754500     668       mov V_amp_mv+3, #00h
0622 22         669       ret
0623            670   
0623            671   _ref_ok:
0623            672       ; Read op-amp output ADC channel 1 (AIN1)
0623 7401       673       mov a, #01h
0625 1205FF     674       lcall Read_ADC
0628            675   
0628            676       ; x = ADC_opamp (16-bit)
0628 8835       677       mov x+0, R0
062A 8936       678       mov x+1, R1
062C 753700     679       mov x+2, #00h
062F 753800     680       mov x+3, #00h
0632            681   
0632            682       ; x = x * 4096  (mV)
0632 7539C4     683            mov y+0, #low (2500 % 0x10000) 
0635 753A09     683            mov y+1, #high(2500 % 0x10000) 
0638 753B00     683            mov y+2, #low (2500 / 0x10000) 
063B 753C00     683            mov y+3, #high(2500 / 0x10000) 
063E 120271     684       lcall mul32
0641            685   
0641            686       ; y = ADC_ref (16-bit)
0641 855239     687       mov y+0, VAL_LM4040+0
0644 85533A     688       mov y+1, VAL_LM4040+1
0647 753B00     689       mov y+2, #00h
064A 753C00     690       mov y+3, #00h
064D            691   
064D            692       ; x = (ADC_opamp * 4096) / ADC_ref  => mV
064D 1202FE     693       lcall div32
0650            694   
0650            695       ; store TRUE mV into V_amp_mv
0650 853542     696       mov V_amp_mv+0, x+0
0653 853643     697       mov V_amp_mv+1, x+1
0656 853744     698       mov V_amp_mv+2, x+2
0659 853845     699       mov V_amp_mv+3, x+3
065C 22         700       ret
065D            701   
065D            702   
065D            703   ;---------------------------------
065D            704   ; VoutmV_To_TempC
065D            705   ; Uses V_amp_mv (TRUE mV)
065D            706   ; Steps:
065D            707   ; 1) uV_opamp = mV * 1000
065D            708   ; 2) uV_tc    = uV_opamp / GAIN (300)
065D            709   ; 3) Temp_cC  = uV_tc * 100 / 41    (41 uV per 1°C)
065D            710   ; 4) add T_cold (centi-°C)
065D            711   ; Output: t_hot = total temp in centi-°C (°C*100)
065D            712   ;---------------------------------
065D            713   VoutmV_To_TempC:
065D            714       ; x = V_amp_mv (mV)
065D E542       715       mov A, V_amp_mv+0
065F F535       716       mov x+0, A
0661 E543       717       mov A, V_amp_mv+1
0663 F536       718       mov x+1, A
0665 E544       719       mov A, V_amp_mv+2
0667 F537       720       mov x+2, A
0669 E545       721       mov A, V_amp_mv+3
066B F538       722       mov x+3, A
066D            723   
066D            724       ; uV_opamp = mV * 1000
066D 7539E8     725            mov y+0, #low (1000 % 0x10000) 
0670 753A03     725            mov y+1, #high(1000 % 0x10000) 
0673 753B00     725            mov y+2, #low (1000 / 0x10000) 
0676 753C00     725            mov y+3, #high(1000 / 0x10000) 
0679 120271     726       lcall mul32
067C            727   
067C            728       ; uV_tc = uV_opamp / 300
067C 75392C     729            mov y+0, #low (300 % 0x10000) 
067F 753A01     729            mov y+1, #high(300 % 0x10000) 
0682 753B00     729            mov y+2, #low (300 / 0x10000) 
0685 753C00     729            mov y+3, #high(300 / 0x10000) 
0688 1202FE     730       lcall div32
068B            731   
068B            732       ; Temp_cC = uV_tc * 100 / 41
068B 753964     733            mov y+0, #low (100 % 0x10000) 
068E 753A00     733            mov y+1, #high(100 % 0x10000) 
0691 753B00     733            mov y+2, #low (100 / 0x10000) 
0694 753C00     733            mov y+3, #high(100 / 0x10000) 
0697 120271     734       lcall mul32
069A            735   
069A 753929     736            mov y+0, #low (41 % 0x10000) 
069D 753A00     736            mov y+1, #high(41 % 0x10000) 
06A0 753B00     736            mov y+2, #low (41 / 0x10000) 
06A3 753C00     736            mov y+3, #high(41 / 0x10000) 
06A6 1202FE     737       lcall div32          ; x now = temp in centi-°C from thermocouple only
06A9            738   
06A9            739       ; add cold junction temp (centi-°C)
06A9 E54A       740       mov A, T_cold+0
06AB F539       741       mov y+0, A
06AD E54B       742       mov A, T_cold+1
06AF F53A       743       mov y+1, A
06B1 E54C       744       mov A, T_cold+2
06B3 F53B       745       mov y+2, A
06B5 E54D       746       mov A, T_cold+3
06B7 F53C       747       mov y+3, A
06B9            748       
06B9            749       
06B9            750       
06B9            751   
06B9 1201BC     752       lcall add32          ; x = x + y
06BC            753   
06BC            754       ; store into t_hot (centi-°C)
06BC E535       755       mov A, x+0
06BE F54E       756       mov t_hot+0, A
06C0 E536       757       mov A, x+1
06C2 F54F       758       mov t_hot+1, A
06C4 E537       759       mov A, x+2
06C6 F550       760       mov t_hot+2, A
06C8 E538       761       mov A, x+3
06CA F551       762       mov t_hot+3, A
06CC 22         763       ret 
