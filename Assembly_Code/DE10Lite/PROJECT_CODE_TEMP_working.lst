0561            509   ; PrintU32: prints unsigned 32-bit ;
0561            510   ; integer in x as decimal over UART;
0561            511   ; Uses div32 (math32.inc): quotient in x, remainder in y
0561            512   ;---------------------------------;
0561            513   
0561            514   
0561            515   PrintU32:
0561            516       ; if x == 0 -> print '0'
0561 E535       517       mov a, x+0
0563 4536       518       orl a, x+1
0565 4537       519       orl a, x+2
0567 4538       520       orl a, x+3
0569 7012       521       jnz PU32_go
056B            522   
056B 7430       523       mov a, #'0'
056D 12054E     524       lcall putchar
