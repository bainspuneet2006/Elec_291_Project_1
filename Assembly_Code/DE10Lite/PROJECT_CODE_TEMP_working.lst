0768            918   ;---------------------------------
0768            919   ; Read_Ref
0768            920   ; Reads LM4040 reference on ADC channel 0
0768            921   ; Stores 16-bit ADC count in VAL_LM4040 (low,high)
0768            922   ;---------------------------------
0768            923   Read_Ref:
0768 7400       924       mov a, #00h            ; ADC channel 0 (AIN0)
076A 120761     925       lcall Read_ADC
076D 8855       926       mov VAL_LM4040+0, R0
076F 8956       927       mov VAL_LM4040+1, R1
0771 22         928       ret
0772            929   
0772            930   
0772            931   ;---------------------------------
0772            932   ; Read_op_amp_mv
0772            933   ; Reads op-amp output on ADC channel 1 (you set #01h)
0772            934   ; Computes V_amp_mv in TRUE mV:
0772            935   ;   Vopamp_mV = ADC_opamp * 4096 / ADC_ref
0772            936   ; Stores result as 32-bit in V_amp_mv
0772            937   ;---------------------------------
0772            938   Read_op_amp_mv:
0772            939       ; if reference reading is 0, avoid divide-by-zero
0772 E555       940       mov A, VAL_LM4040+0
0774 4556       941       orl A, VAL_LM4040+1
0776 700D       942       jnz _ref_ok
0778            943   
0778            944       ; V_amp_mv = 0
0778 754900     945       mov V_amp_mv+0, #00h
077B 754A00     946       mov V_amp_mv+1, #00h
077E 754B00     947       mov V_amp_mv+2, #00h
0781 754C00     948       mov V_amp_mv+3, #00h
0784 22         949       ret
0785            950   
0785            951   _ref_ok:
0785            952       ; Read op-amp output ADC channel 1 (AIN1)
0785 7401       953       mov a, #01h
0787 120761     954       lcall Read_ADC
078A            955   
078A            956       ; x = ADC_opamp (16-bit)
078A 8840       957       mov x+0, R0
078C 8941       958       mov x+1, R1
078E 754200     959       mov x+2, #00h
0791 754300     960       mov x+3, #00h
0794            961   
0794            962       ; x = x * 4096  (mV)
0794 754407     963            mov y+0, #low (4103 % 0x10000) 
0797 754510     963            mov y+1, #high(4103 % 0x10000) 
079A 754600     963            mov y+2, #low (4103 / 0x10000) 
079D 754700     963            mov y+3, #high(4103 / 0x10000) 
07A0 120271     964       lcall mul32
07A3            965   
07A3            966       ; y = ADC_ref (16-bit)
07A3 855544     967       mov y+0, VAL_LM4040+0
07A6 855645     968       mov y+1, VAL_LM4040+1
07A9 754600     969       mov y+2, #00h
07AC 754700     970       mov y+3, #00h
07AF            971   
07AF            972       ; x = (ADC_opamp * 4096) / ADC_ref  => mV
07AF 1202FE     973       lcall div32
07B2            974   
07B2            975       ; store TRUE mV into V_amp_mv
07B2 854049     976       mov V_amp_mv+0, x+0
07B5 85414A     977       mov V_amp_mv+1, x+1
07B8 85424B     978       mov V_amp_mv+2, x+2
07BB 85434C     979       mov V_amp_mv+3, x+3
07BE 22         980       ret
07BF            981   
07BF            982   
07BF            983   ;---------------------------------
07BF            984   ; VoutmV_To_TempC
07BF            985   ; Uses V_amp_mv (TRUE mV)
07BF            986   ; Steps:
07BF            987   ; 1) uV_opamp = mV * 1000
07BF            988   ; 2) uV_tc    = uV_opamp / GAIN (300)
07BF            989   ; 3) Temp_cC  = uV_tc * 100 / 41    (41 uV per 1°C)
07BF            990   ; 4) add T_cold (centi-°C)
07BF            991   ; Output: t_hot = total temp in centi-°C (°C*100)
07BF            992   ;---------------------------------
07BF            993   VoutmV_To_TempC:
07BF            994       ; x = V_amp_mv (mV)
07BF E549       995       mov A, V_amp_mv+0
07C1 F540       996       mov x+0, A
07C3 E54A       997       mov A, V_amp_mv+1
07C5 F541       998       mov x+1, A
07C7 E54B       999       mov A, V_amp_mv+2
07C9 F542      1000       mov x+2, A
07CB E54C      1001       mov A, V_amp_mv+3
07CD F543      1002       mov x+3, A
07CF           1003   
07CF           1004       ; uV_opamp = mV * 1000
07CF 7544E8    1005            mov y+0, #low (1000 % 0x10000) 
07D2 754503    1005            mov y+1, #high(1000 % 0x10000) 
07D5 754600    1005            mov y+2, #low (1000 / 0x10000) 
07D8 754700    1005            mov y+3, #high(1000 / 0x10000) 
07DB 120271    1006       lcall mul32
07DE           1007   
07DE           1008       ; uV_tc = uV_opamp / 300
07DE 75442C    1009            mov y+0, #low (300 % 0x10000) 
07E1 754501    1009            mov y+1, #high(300 % 0x10000) 
07E4 754600    1009            mov y+2, #low (300 / 0x10000) 
07E7 754700    1009            mov y+3, #high(300 / 0x10000) 
07EA 1202FE    1010       lcall div32
07ED           1011   
07ED           1012       ; Temp_cC = uV_tc * 100 / 41
07ED 754464    1013            mov y+0, #low (100 % 0x10000) 
07F0 754500    1013            mov y+1, #high(100 % 0x10000) 
07F3 754600    1013            mov y+2, #low (100 / 0x10000) 
07F6 754700    1013            mov y+3, #high(100 / 0x10000) 
07F9 120271    1014       lcall mul32
07FC           1015   
07FC 754429    1016            mov y+0, #low (41 % 0x10000) 
07FF 754500    1016            mov y+1, #high(41 % 0x10000) 
0802 754600    1016            mov y+2, #low (41 / 0x10000) 
0805 754700    1016            mov y+3, #high(41 / 0x10000) 
0808 1202FE    1017       lcall div32          ; x now = temp in centi-°C from thermocouple only
080B           1018   
080B           1019       ; add cold junction temp (centi-°C)
080B E54D      1020       mov A, T_cold+0
080D F544      1021       mov y+0, A
080F E54E      1022       mov A, T_cold+1
0811 F545      1023       mov y+1, A
0813 E54F      1024       mov A, T_cold+2
0815 F546      1025       mov y+2, A
0817 E550      1026       mov A, T_cold+3
0819 F547      1027       mov y+3, A
081B           1028       
081B 1201BC    1029       lcall add32          ; x = x + y
081E           1030   
081E           1031       ; store into t_hot (centi-°C)
081E E540      1032       mov A, x+0
0820 F551      1033       mov t_hot+0, A
0822 E541      1034       mov A, x+1
0824 F552      1035       mov t_hot+1, A
0826 E542      1036       mov A, x+2
0828 F553      1037       mov t_hot+2, A
082A E543      1038       mov A, x+3
082C F554      1039       mov t_hot+3, A
082E 22        1040       ret 
