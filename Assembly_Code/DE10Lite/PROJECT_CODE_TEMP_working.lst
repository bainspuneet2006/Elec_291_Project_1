0B30           1263   
0B30           1264   Get3Digits:
0B30 C3        1265       clr c
0B31 C0E0      1266       push acc
0B33 C0F0      1267       push b
0B35 C0D0      1268       push psw
0B37           1269   
0B37 120993    1270       lcall Keypad
0B3A 503C      1271       jnc G3_no_key
0B3C           1272   
0B3C           1273       ; Key pressed (code in R7)
0B3C           1274   
0B3C           1275       ; CHECK FOR 'ENTER' (e.g. # key which is 0x0F or 0x0D depending on map)
0B3C           1276       ; Assuming keypad_default maps ROW4/COL4 to 0x0D (#) or similar.
0B3C           1277       ; Check your Keypad_Key_Code routine.
0B3C           1278       ; K_R4_C4 -> #0DH. So if R7 == 0x0D, it's enter.
0B3C           1279   
0B3C EF        1280       mov a, R7
0B3D B40D0C    1281       cjne a, #0DH, G3_check_digit
0B40           1282       ; ENTER PRESSED
0B40           1283       ; If we have at least 1 digit, accept it
0B40 E55F      1284       mov a, edit_digits
0B42 603C      1285       jz G3_exit ; ignore empty enter
0B44           1286   
0B44 D0D0      1287       pop psw ; Restore PSW (carry=0)
0B46 D3        1288       setb c  ; Set carry = 1 (DONE)
0B47 D0F0      1289       pop b
0B49 D0E0      1290       pop acc
0B4B 22        1291       ret
0B4C           1292   
0B4C           1293   G3_check_digit:
0B4C           1294       ; Accept only 0..9
0B4C EF        1295       mov a, R7
0B4D C3        1296       clr c
0B4E 940A      1297       subb a, #0Ah
0B50 502E      1298       jnc G3_exit             
0B52           1299   
0B52           1300       ; Check overflow (3 digits max)
0B52 E55F      1301       mov a, edit_digits
0B54 B40302    1302       cjne a, #3, G3_build
0B57 8027      1303       sjmp G3_exit
0B59           1304   
0B59           1305   G3_build:
0B59           1306       ; val = val*10 + new
0B59 E55E      1307       mov a, edit_value
0B5B 255E      1308       add a, edit_value       
0B5D F5F0      1309       mov b, a                 
0B5F E55E      1310       mov a, edit_value
0B61 23        1311       rl a
0B62 23        1312       rl a
0B63 23        1313       rl a                     
0B64 25F0      1314       add a, b                 
0B66 2F        1315       add a, R7               
0B67           1316   
0B67 F55E      1317       mov edit_value, a
0B69 055F      1318       inc edit_digits
0B6B           1319   
0B6B           1320       ; If 3 digits reached, done automatically
0B6B E55F      1321       mov a, edit_digits
0B6D B40310    1322       cjne a, #3, G3_exit
0B70           1323   
0B70           1324       ; DONE (3 digits)
0B70 D0D0      1325       pop psw  ; Restore PSW (Carry=0)
0B72 D3        1326       setb c   ; Force Carry=1
0B73 D0F0      1327       pop b
0B75 D0E0      1328       pop acc
0B77 22        1329       ret
0B78           1330   
0B78           1331   G3_no_key:
