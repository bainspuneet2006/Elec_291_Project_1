0734 C3         877       clr c
0735 9464       878       subb a, #100
0737 FC         879       mov R4, a
0738 EB         880       mov a, R3
0739 9400       881       subb a, #0
073B FB         882       mov R3, a
073C 0A         883       inc R2
073D 80EB       884       sjmp Hund_loop
