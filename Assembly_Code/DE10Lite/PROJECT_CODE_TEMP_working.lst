082F           1045   ; PrintStateSerial
082F           1046   ; Prints: "STATE=" then FSM1_state as 1 digit, then CRLF
082F           1047   ; Uses: putchar, SendString
082F           1048   ;---------------------------------
082F 53544154  1049   StateLabel: db 'STATE=',0
     453D00
0836           1050   
0836           1051   PrintStateSerial:
0836 C0E0      1052       push acc
0838 C082      1053       push dpl
083A C083      1054       push dph
083C           1055   
083C 90082F    1056       mov dptr, #StateLabel
083F 1206B3    1057       lcall SendString
0842           1058   
0842 E537      1059       mov a, FSM1_state         ; 0..6
0844 2430      1060       add a, #'0'               ; convert to ASCII
0846 1206AB    1061       lcall putchar
0849           1062   
0849 740D      1063       mov a, #0Dh               ; CR
084B 1206AB    1064       lcall putchar
084E 740A      1065       mov a, #0Ah               ; LF
0850 1206AB    1066       lcall putchar
0853           1067   
0853 D083      1068       pop dph
0855 D082      1069       pop dpl
0857 D0E0      1070       pop acc
0859 22        1071       ret
085A           1072   
