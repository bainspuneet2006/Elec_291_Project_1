0535            471   Initialize_Serial_Port:
0535            472            ; Configure serial port and baud rate
0535 C28E       473            clr TR1 ; Disable timer 1
0537 53890F     474            anl TMOD, #0x0f ; Mask the bits for timer 1
053A 438920     475            orl TMOD, #0x20 ; Set timer 1 in 8-bit auto reload mode
