049E            329   ; NEW: Show elapsed time on LCD (row1 col13..16) if state != 0
049E            330   ; Displays elapsed seconds as 4 digits, saturates at 9999.
049E            331   ; ==========================================================
049E            332   Display_Elapsed_LCD:
049E C0E0       333       push acc
04A0 C0F0       334       push b
04A2 C0D0       335       push psw
04A4            336   
04A4            337       ; Only show if not state 0
04A4 E537       338       mov a, FSM1_state
04A6 6072       339       jz DEL_Clear
04A8            340   
04A8            341       ; Copy elapsed_sec to R3:R4 (16-bit)
04A8 AC40       342       mov R4, elapsed_sec+0
04AA AB41       343       mov R3, elapsed_sec+1
04AC            344   
04AC            345       ; Cap at 9999 for display safety
04AC            346       ; if R3:R4 > 9999 then force 9999
04AC EB         347       mov a, R3
04AD C3         348       clr c
04AE 9427       349       subb a, #high(9999)
04B0 400E       350       jc DEL_Print
04B2 7008       351       jnz DEL_Force9999
04B4 EC         352       mov a, R4
04B5 C3         353       clr c
04B6 940F       354       subb a, #low(9999)
04B8 5002       355       jnc DEL_Force9999
04BA 8004       356       sjmp DEL_Print
04BC            357   
04BC            358   DEL_Force9999:
04BC 7B27       359       mov R3, #high(9999)
04BE 7C0F       360       mov R4, #low(9999)
04C0            361   
04C0            362   DEL_Print:
04C0            363       ; thousands, hundreds, tens, ones using repeated subtraction
04C0 7A00       364       mov R2, #0    ; thousands
04C2            365   DEL_Thou_L:
04C2            366       ; if < 1000 stop
04C2 EB         367       mov a, R3
04C3 7006       368       jnz DEL_Thou_Sub
04C5 EC         369       mov a, R4
04C6 C3         370       clr c
04C7 94E8       371       subb a, #low(1000)
04C9 400C       372       jc DEL_Thou_D
04CB            373   DEL_Thou_Sub:
04CB            374       ; (R3:R4) -= 1000
04CB EC         375       mov a, R4
04CC C3         376       clr c
04CD 94E8       377       subb a, #low(1000)
04CF FC         378       mov R4, a
04D0 EB         379       mov a, R3
04D1 9403       380       subb a, #high(1000)
04D3 FB         381       mov R3, a
04D4 0A         382       inc R2
04D5 80EB       383       sjmp DEL_Thou_L
04D7            384   DEL_Thou_D:
04D7            385   
04D7 7900       386       mov R1, #0    ; hundreds
04D9            387   DEL_Hund_L:
04D9            388       ; if < 100 stop
04D9 EB         389       mov a, R3
04DA 7006       390       jnz DEL_Hund_Sub
04DC EC         391       mov a, R4
04DD C3         392       clr c
04DE 9464       393       subb a, #100
04E0 400C       394       jc DEL_Hund_D
04E2            395   DEL_Hund_Sub:
04E2 EC         396       mov a, R4
04E3 C3         397       clr c
04E4 9464       398       subb a, #100
04E6 FC         399       mov R4, a
04E7 EB         400       mov a, R3
04E8 9400       401       subb a, #0
04EA FB         402       mov R3, a
04EB 09         403       inc R1
04EC 80EB       404       sjmp DEL_Hund_L
04EE            405   DEL_Hund_D:
04EE            406   
04EE            407       ; tens and ones from remaining (0..99) in R4
04EE EC         408       mov a, R4
04EF 75F00A     409       mov b, #10
04F2 84         410       div ab        ; A=tens, B=ones
04F3 F8         411       mov R0, A     ; tens
04F4 AFF0       412       mov R7, B     ; ones
04F6            413   
