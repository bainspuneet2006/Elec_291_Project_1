06BE E540       796       mov a, x+0
06C0 4541       797       orl a, x+1
06C2 4542       798       orl a, x+2
06C4 4543       799       orl a, x+3
06C6 7012       800       jnz PU32_go
06C8            801   
06C8 7430       802       mov a, #'0'
