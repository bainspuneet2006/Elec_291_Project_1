0000             27   CLK           EQU 33333333 ; Microcontroller system crystal frequency in Hz
0000             28   TIMER0_RATE   EQU 4096     ; 2048Hz squarewave (peak amplitude of CEM-1203 speaker)
0000             29   TIMER0_RELOAD EQU ((65536-(CLK/(12*TIMER0_RATE)))) ; The prescaler in the CV-8052 is always 12 unlike the N76E003 where is selectable.
0000             30   TIMER2_RATE   EQU 1000     ; 1000Hz, for a timer tick of 1ms
0000             31   TIMER2_RELOAD EQU ((65536-(CLK/(12*TIMER2_RATE))))
0000             32   
0000             33   SOUND_OUT     equ P1.5
0000             34   UPDOWN        equ SWA.0
0000             35   Play_beeps_Switch equ SWA.1
0000             36   Start_Switch equ SWA.2
0000             37   
0000             38   ;-------I dont know which pin we are connecting to 
0000             39   ; the SSR box so we can change this accordingly
0000             40   ; [important] if we change that we also need to change
0000             41   ; P2MOD accordinlgy
0000             42   SSR_PIN equ P3.7 
0000             43   
0000             44   ; Unfortunately the maximum baurate we can use with timer 1 is 57600
0000             45   ; so make sure you configure putty/matlab/python accordingly.
0000             46   BAUD            EQU 57600
0000             47   TIMER_1_RELOAD  EQU (256-((2*CLK)/(12*32*BAUD)))
