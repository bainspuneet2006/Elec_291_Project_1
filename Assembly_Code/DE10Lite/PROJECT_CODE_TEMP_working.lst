0692            753   Initialize_Serial_Port:
0692            754            ; Configure serial port and baud rate
0692 C28E       755            clr TR1 ; Disable timer 1
0694 53890F     756            anl TMOD, #0x0f ; Mask the bits for timer 1
0697 438920     757            orl TMOD, #0x20 ; Set timer 1 in 8-bit auto reload mode
069A 438780     758            orl PCON, #80H ; Set SMOD to 1
069D 758DFD     759            mov TH1, #low(TIMER_1_RELOAD)
06A0 758BFD     760            mov TL1, #low(TIMER_1_RELOAD)
06A3 D28E       761            setb TR1 ; Enable timer 1
06A5 759852     762            mov SCON, #52H
06A8 D299       763       setb TI  ; FIX: prime TX so first putchar doesn't stall
06AA 22         764            ret
