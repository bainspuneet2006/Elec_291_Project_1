0704            844   send_temp_serial:
0704            845       ; x = t_hot (centi-degC)
0704 855140     846       mov x+0, t_hot+0
0707 855241     847       mov x+1, t_hot+1
070A 855342     848       mov x+2, t_hot+2
070D 855443     849       mov x+3, t_hot+3
0710            850   
0710            851       ; x = x / 100  -> integer degrees C
0710 754464     852            mov y+0, #low (100 % 0x10000) 
0713 754500     852            mov y+1, #high(100 % 0x10000) 
0716 754600     852            mov y+2, #low (100 / 0x10000) 
0719 754700     852            mov y+3, #high(100 / 0x10000) 
071C 1202FE     853       lcall div32          ; x now = integer °C (0..300-ish)
071F 85403E     854       mov temp, x+0
0722 E55F       855   mov a, temp_avg
0724            856   
0724            857       ; --- print as exactly 3 digits: H T O ---
0724            858       ; R3:R4 = x (16-bit is enough here)
0724 AC40       859       mov R4, x+0
0726 AB41       860       mov R3, x+1
0728            861   
0728            862       ; hundreds in R2
0728 7A00       863       mov R2, #0
072A            864   
072A            865   Hund_loop:
072A            866       ; if (R3:R4) < 100 stop
072A EB         867       mov a, R3
072B 7006       868       jnz Hund_sub
072D EC         869       mov a, R4
072E C3         870       clr c
072F 9464       871       subb a, #100
0731 400C       872       jc  Hund_done
0733            873   
0733            874   Hund_sub:
