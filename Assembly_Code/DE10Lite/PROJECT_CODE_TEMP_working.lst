041F            277       ; Put stack above your variables but still below 0x7F.
041F 758160     278       mov SP, #0x60
0422            279   
0422 120379     280       lcall Timer0_Init
0425 120395     281       lcall Timer2_Init
0428 120535     282            lcall Initialize_Serial_Port
042B            283   
042B            284       ; We use the pins of P0 to control the LCD.  Configure as outputs.
042B 759AAA     285       mov P0MOD, #10101010b ; P0.1, P0.3, P0.5, P0.7 are outputs.  ('1' makes the pin output)
042E            286       ; We use pins P1.5 and P1.1 as outputs also.  Configure accordingly.
042E 759BA2     287       mov P1MOD, #10100010b ; P1.7 and P1.1 are outputs
0431 759CFF     288       mov P2MOD, #0xff
0434 759DFF     289       mov P3MOD, #0xff
0437            290   
0437            291       ; Turn off all the LEDs
0437 75E800     292       mov LEDRA, #0 ; LEDRA is bit addressable
043A 759500     293       mov LEDRB, #0 ; LEDRB is NOT bit addresable
043D            294   
043D D2AF       295       setb EA   ; Enable Global interrupts
043F            296   
043F 12009C     297       lcall ELCD_4BIT ; Configure LCD in four bit mode
0442            298   
0442            299       ; For convenience a few handy macros are included in 'LCD_4bit_DE1Lite.inc':
0442 C0E0       300            push acc
0444 7401       300            mov a, #1
0446 14         300            dec a
0447 1200DC     300            lcall ?Set_Cursor_1 ; Select column and row
044A D0E0       300            pop acc
044C C083       301            push dph
044E C082       301            push dpl
0450 C0E0       301            push acc
0452 900367     301            mov dptr, #Initial_Message
0455 1200CF     301            lcall ?Send_Constant_String
0458 D0E0       301            pop acc
045A D082       301            pop dpl
045C D083       301            pop dph
045E D200       302       setb half_seconds_flag
0460 753200     303            mov BCD_counter, #0x00 ; Initialize counter to zero
0463            304   
0463 754A98     305       mov T_cold+0, #098h   ; 2200 low byte
0466 754B08     306       mov T_cold+1, #008h   ; 2200 high byte
0469 754C00     307       mov T_cold+2, #000h
046C 754D00     308       mov T_cold+3, #000h
046F 75A180     309            mov ADC_C, #080h ; Reset ADC
0472 C002       310            push AR2
0474 7A32       310            mov R2, #50
0476 12004D     310            lcall ?Wait_Milli_Seconds
0479 D002       310            pop AR2
047B            311   
047B            312            ; After initialization the program stays in this 'forever' loop
047B            313   loop:
047B            314   
047B            315   
047B            316   ;testing to playbeeps when switch is on. Replace this in fsm. call functions for 1, 5 or 10 beeps 
047B 30E906     317   jnb Play_beeps_Switch, skip_beep
047E 300003     318   jnb half_seconds_flag, skip_beep
0481 120571     319   lcall playSingle_beep
0484            320   
0484            321   skip_beep:
0484 20F91C     322            jb KEY.1, loop_a  ; if the KEY1 button is not pressed skip
0487 C002       323            push AR2
0489 7A32       323            mov R2, #50
048B 12004D     323            lcall ?Wait_Milli_Seconds
048E D002       323            pop AR2         ; Debounce delay.  This macro is also in 'LCD_4bit_DE1Lite.inc'
0490 20F910     324            jb KEY.1, loop_a  ; if the KEY1 button is not pressed skip
0493 30F9FD     325            jnb KEY.1, $            ; Wait for button release.  The '$' means: jump to same instruction.
0496            326            ; A valid press of the 'BOOT' button has been detected, reset the BCD counter.
0496            327            ; But first stop timer 2 and reset the milli-seconds counter, to resync everything.
0496 C2CA       328            clr TR2 ; Stop timer 2
0498 E4         329            clr a
0499            330   
0499 F530       331            mov Count1ms+0, a
049B F531       332            mov Count1ms+1, a
049D            333            ; Now clear the BCD counter
049D F532       334            mov BCD_counter, a
049F D2CA       335            setb TR2    ; Start timer 2
04A1 8003       336            sjmp loop_b ; Display the new value
04A3            337   loop_a:
04A3 3000D5     338            jnb half_seconds_flag, loop
04A6            339   loop_b:
04A6 C200       340       clr half_seconds_flag ; We clear this flag in the main loop, but it is set in the ISR for timer 2
04A8            341   
