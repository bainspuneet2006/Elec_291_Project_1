0621            644   ; =======================================================
0621            645   ; Display_TempC_7Seg
0621            646   ; Displays temperature (integer °C) on HEX2 HEX1 HEX0
0621            647   ; Uses:
0621            648   ;   t_hot  = centi-°C (°C*100)  [already computed in VoutmV_To_TempC]
0621            649   ;   math32 div32 (x = x/y)
0621            650   ; Reuses T_7seg table (0..9)
0621            651   ; =======================================================
0621            652   Display_TempC_7Seg:
0621 C0E0       653       push acc
0623 C0F0       654       push b
0625 C082       655       push dpl
0627 C083       656       push dph
0629            657   
0629            658       ; x = t_hot (centi-°C)
0629 855140     659       mov x+0, t_hot+0
062C 855241     660       mov x+1, t_hot+1
062F 855342     661       mov x+2, t_hot+2
0632 855443     662       mov x+3, t_hot+3
0635            663   
0635            664       ; x = x / 100  -> integer °C
0635 754464     665            mov y+0, #low (100 % 0x10000) 
0638 754500     665            mov y+1, #high(100 % 0x10000) 
063B 754600     665            mov y+2, #low (100 / 0x10000) 
063E 754700     665            mov y+3, #high(100 / 0x10000) 
0641 1202FE     666       lcall div32              ; x now = integer °C
0644            667   
0644            668       ; Copy integer temp to R3:R4 (16-bit is enough)
0644 AC40       669       mov R4, x+0
0646 AB41       670       mov R3, x+1
0648            671   
0648            672       ; -------------------------
0648            673       ; Compute hundreds in R2
0648            674       ; -------------------------
0648 7A00       675       mov R2, #0               ; hundreds
064A            676   
064A            677   DT_Hund_Loop:
064A            678       ; if (R3:R4) < 100 stop
064A EB         679       mov a, R3
064B 7006       680       jnz DT_Hund_Sub
064D EC         681       mov a, R4
064E C3         682       clr c
064F 9464       683       subb a, #100
0651 400C       684       jc  DT_Hund_Done
0653            685   
0653            686   DT_Hund_Sub:
0653            687       ; (R3:R4) -= 100
0653 EC         688       mov a, R4
0654 C3         689       clr c
0655 9464       690       subb a, #100
0657 FC         691       mov R4, a
0658 EB         692       mov a, R3
0659 9400       693       subb a, #0
065B FB         694       mov R3, a
065C 0A         695       inc R2
065D 80EB       696       sjmp DT_Hund_Loop
065F            697   
065F            698   DT_Hund_Done:
065F            699       ; Now R2 = hundreds (0..9), remaining value in R4 is 0..99
065F            700   
065F            701       ; tens/ones from remaining
065F EC         702       mov a, R4
0660 75F00A     703       mov b, #10
0663 84         704       div ab                   ; A=tens (0..9), B=ones (0..9)
0664 F9         705       mov R1, A                ; tens
0665 A8F0       706       mov R0, B                ; ones
0667            707   
0667            708       ; -------------------------
0667            709       ; Map digits to 7-seg and write HEX2..HEX0
0667            710       ; -------------------------
0667 90044C     711       mov dptr, #T_7seg
066A            712   
066A            713       ; ones -> HEX0
066A E8         714       mov a, R0
066B 93         715       movc a, @a+dptr
066C F591       716       mov HEX0, a
066E            717   
066E            718       ; tens -> HEX1 (blank if hundreds=0 and tens=0)
066E EA         719       mov a, R2
066F 7008       720       jnz DT_Show_Tens
0671 E9         721       mov a, R1
0672 7005       722       jnz DT_Show_Tens
0674 7592FF     723       mov HEX1, #0FFh
0677 8004       724       sjmp DT_Do_Hund
0679            725   
0679            726   DT_Show_Tens:
0679 E9         727       mov a, R1
067A 93         728       movc a, @a+dptr
067B F592       729       mov HEX1, a
067D            730   
067D            731   DT_Do_Hund:
067D            732       ; hundreds -> HEX2 (blank if 0)
067D EA         733       mov a, R2
067E 7005       734       jnz DT_Show_Hund
0680 7593FF     735       mov HEX2, #0FFh
0683 8004       736       sjmp DT_Done
0685            737   
0685            738   DT_Show_Hund:
0685 EA         739       mov a, R2
0686 93         740       movc a, @a+dptr
0687 F593       741       mov HEX2, a
0689            742   
0689            743   DT_Done:
0689 D083       744       pop dph
068B D082       745       pop dpl
068D D0F0       746       pop b
068F D0E0       747       pop acc
0691 22         748       ret
0692            749   ; Displays a BCD number in HEX1-HEX0
