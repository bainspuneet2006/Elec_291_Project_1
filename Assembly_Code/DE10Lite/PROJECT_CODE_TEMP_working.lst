0379            123   ; Routine to initialize the ISR   ;
0379            124   ; for timer 0                     ;
0379            125   ;---------------------------------;
0379            126   Timer0_Init:
0379 E589       127            mov a, TMOD
037B 54F0       128            anl a, #0xf0 ; Clear the bits for timer 0
037D 4401       129            orl a, #0x01 ; Configure timer 0 as 16-timer
037F F589       130            mov TMOD, a
0381 758CFD     131            mov TH0, #high(TIMER0_RELOAD)
0384 758A5A     132            mov TL0, #low(TIMER0_RELOAD)
0387            133            ; Enable the timer and interrupts
0387 D2A9       134       setb ET0  ; Enable timer 0 interrupt
0389 C28C       135       clr TR0  ; Start timer 0
038B 22         136            ret
038C            137   
038C            138   ;---------------------------------;
038C            139   ; ISR for timer 0.  Set to execute;
038C            140   ; every 1/4096Hz to generate a    ;
038C            141   ; 2048 Hz square wave at pin P3.7 ;
038C            142   ;---------------------------------;
038C            143   Timer0_ISR:
038C            144            ;clr TF0  ; According to the data sheet this is done for us already.
038C 758CFD     145            mov TH0, #high(TIMER0_RELOAD) ; Timer 0 doesn't have autoreload in the CV-8052
038F 758A5A     146            mov TL0, #low(TIMER0_RELOAD)
0392 B295       147            cpl SOUND_OUT ; Connect speaker to P3.7!
0394 32         148            reti
0395            149   
0395            150   
0395            151   ;---------------------------------;
0395            152   ; Routine to initialize the ISR   ;
0395            153   ; for timer 2                     ;
0395            154   ;---------------------------------;
0395            155   Timer2_Init:
0395 75C800     156            mov T2CON, #0 ; Stop timer/counter.  Autoreload mode.
0398 75CDF5     157            mov TH2, #high(TIMER2_RELOAD)
039B 75CC27     158            mov TL2, #low(TIMER2_RELOAD)
039E            159            ; Set the reload value
039E 75CBF5     160            mov RCAP2H, #high(TIMER2_RELOAD)
03A1 75CA27     161            mov RCAP2L, #low(TIMER2_RELOAD)
03A4            162            ; Init One millisecond interrupt counter.  It is a 16-bit variable made with two 8-bit parts
03A4 E4         163            clr a
03A5 F530       164            mov Count1ms+0, a
03A7 F531       165            mov Count1ms+1, a
03A9            166            ; Enable the timer and interrupts
03A9 D2AD       167       setb ET2  ; Enable timer 2 interrupt
03AB D2CA       168       setb TR2  ; Enable timer 2
03AD 22         169            ret
03AE            170   
03AE            171   
03AE            172   ;---------------------------------;
03AE            173   ; ISR for timer 2                 ;
03AE            174   ;---------------------------------;
03AE            175   Timer2_ISR:
03AE C2CF       176            clr TF2  ; Timer 2 doesn't clear TF2 automatically. Do it in ISR
03B0            177   
03B0            178       ; FIX: DO NOT toggle P1.1 here. P1.1 is LCD E pin (ELCD_E equ P1.1)
03B0            179       ; cpl P1.1 ; <-- REMOVED
03B0            180   
03B0            181            ; Save registers used (stronger save to avoid corruption w/ LCD + math32)
03B0 C0E0       182            push acc
03B2 C0D0       183            push psw
03B4 C0F0       184       push b
03B6 C082       185       push dpl
03B8 C083       186       push dph
03BA            187   
03BA            188            ; Increment the 16-bit one mili second counter
03BA 0530       189            inc Count1ms+0    ; Increment the low 8-bits first
03BC E530       190            mov a, Count1ms+0 ; If the low 8-bits overflow, then increment high 8-bits
03BE 7002       191            jnz Inc_Done
03C0 0531       192            inc Count1ms+1
03C2            193   
03C2            194   Inc_Done:
03C2            195            ; Check if half second has passed
03C2 E530       196            mov a, Count1ms+0
03C4 B4F43D     197            cjne a, #low(500), Timer2_ISR_done ; Warning: this instruction changes the carry flag!
03C7 E531       198            mov a, Count1ms+1
03C9 B40138     199            cjne a, #high(500), Timer2_ISR_done
03CC            200   
03CC            201            
03CC            202            
03CC E4         203            clr a
03CD            204            
03CD F530       205            mov Count1ms+0, a
03CF F531       206            mov Count1ms+1, a
03D1            207            ; 500 milliseconds have passed.  Set a flag so the main program knows
03D1 D200       208            setb half_seconds_flag ; Let the main program know half second had passed
03D3            209            ; Toggle LEDR0 so it blinks
03D3 B2E8       210            cpl LEDRA.0
03D5            211            
03D5 E533       212            mov a, beep_count
03D7 6016       213            jz stop_beeping
03D9            214            
03D9 E534       215            mov a, beep_state
03DB 600B       216            jz turn_beep_on
03DD            217            
03DD C28C       218            clr TR0 ; Enable/disable timer/counter 0. This line creates a beep-silence-beep-silence sound.
03DF            219            ; Reset to zero the milli-seconds counter, it is a 16-bit variable
03DF C295       220            clr SOUND_OUT
03E1 753400     221            mov beep_state, #0
03E4 1533       222            dec beep_count
03E6 800E       223            sjmp beep_done
03E8            224            
03E8            225            
03E8            226            turn_beep_on:
03E8 D28C       227            setb TR0
03EA 753401     228            mov beep_state, #1
03ED 8007       229            sjmp beep_done
03EF            230            
03EF            231            
03EF            232   stop_beeping: 
03EF C28C       233   clr TR0
03F1 C295       234   clr SOUND_OUT
03F3 753400     235   mov beep_state, #0
03F6            236   
03F6            237            
03F6            238            beep_done:
03F6            239            
03F6            240            ; Increment the BCD counter
03F6 E532       241            mov a, BCD_counter
03F8 20E804     242            jb UPDOWN, Timer2_ISR_decrement
03FB 2401       243            add a, #0x01
03FD 8002       244            sjmp Timer2_ISR_da
03FF            245            
03FF            246   Timer2_ISR_decrement:
03FF 2499       247            add a, #0x99 ; Adding the 10-complement of -1 is like subtracting 1.
0401            248   Timer2_ISR_da:
0401 D4         249            da a ; Decimal adjust instruction.  Check datasheet for more details!
0402 F532       250            mov BCD_counter, a
0404            251   
0404            252   Timer2_ISR_done:
0404 D083       253       pop dph
0406 D082       254       pop dpl
0408 D0F0       255       pop b
040A D0D0       256            pop psw
040C D0E0       257            pop acc
040E 32         258            reti
040F            259   
040F            260   
040F            261   ; Look-up table for the 7-seg displays. (Segments are turn on with zero)
040F            262   T_7seg:
040F C0F9A4B0   263       DB 0xC0, 0xF9, 0xA4, 0xB0, 0x99        ; 0 TO 4
     99
0414 9282F880   264       DB 0x92, 0x82, 0xF8, 0x80, 0x90        ; 4 TO 9
     90
0419 8883C6A1   265       DB 0x88, 0x83, 0xC6, 0xA1, 0x86, 0x8E  ; A to F
     868E
