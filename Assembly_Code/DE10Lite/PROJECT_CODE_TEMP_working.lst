09A4           1095   
               1096   showBCD MAC
               1097   ; Display LSD
               1098       mov A, %0
               1099       anl a, #0fh
               1100       movc A, @A+dptr
               1101       mov %1, A
               1102   ; Display MSD
               1103       mov A, %0
               1104       swap a
               1105       anl a, #0fh
               1106       movc A, @A+dptr
               1107       mov %2, A
               1108   ENDMAC
09A4           1109   
09A4           1110   
09A4           1111   
               1112   MYRLC MAC
               1113   mov a, %0
               1114   rlc a
               1115   mov %0, a
               1116   ENDMAC
09A4           1117   
09A4           1118   
               1119   MYRRC MAC
               1120   mov a, %0
               1121   rrc a
               1122   mov %0, a
               1123   ENDMAC
09A4           1124   
09A4           1125   
09A4           1126   
09A4           1127   Wait25ms:
09A4           1128   ;33.33MHz, 1 clk per cycle: 0.03us
09A4 780F      1129   mov R0, #15
09A6           1130   L33:
09A6 794A      1131   mov R1, #74
09A8           1132   L22:
09A8 7AFA      1133   mov R2, #250
09AA           1134   L11:
09AA DAFE      1135   djnz R2, L11 ;3*250*0.03us=22.5us
09AC D9FA      1136       djnz R1, L22 ;74*22.5us=1.665ms
09AE D8F6      1137       djnz R0, L33 ;1.665ms*15=25ms
09B0 22        1138       ret
09B1           1139   
               1140   CHECK_COLUMN MAC
               1141   jb %0, CHECK_COL_%M
