09B1           1149   Configure_Keypad_Pins:
09B1           1150   ; Configure the row pins as output and the column pins as inputs
09B1 439B54    1151   orl P1MOD, #0b_01010100 ; P1.6, P1.4, P1.2 output
09B4 439C01    1152   orl P2MOD, #0b_00000001 ; P2.0 output
09B7 539CAB    1153   anl P2MOD, #0b_10101011 ; P2.6, P2.4, P2.2 input
09BA 539DFE    1154   anl P3MOD, #0b_11111110 ; P3.0 input
09BD 22        1155   ret
09BE           1156   
09BE           1157   ; These are the pins used for the keypad in this program:
09BE           1158   ROW1 EQU P1.2
09BE           1159   ROW2 EQU P1.4
09BE           1160   ROW3 EQU P1.6
09BE           1161   ROw4 EQU P2.0
09BE           1162   COL1 EQU P2.2
09BE           1163   COL2 EQU P2.4
09BE           1164   COL3 EQU P2.6
09BE           1165   COL4 EQU P3.0
09BE           1166   
09BE           1167   ; This subroutine scans a 4x4 keypad.  If a key is pressed sets the carry
09BE           1168   ; to one and returns the key code in register R7.
09BE           1169   ; It works with both a default keypad or a modified keypad with the labels
09BE           1170   ; rotated 90 deg ccw.  The type of keypad is determined by SW0, which is bit SWA.0
09BE           1171   Keypad:
09BE           1172   ; First check the backspace/correction pushbutton.  We use KEY1 for this function.
               1172   $MESSAGE TIP: KEY1 is the erase key
09BE 20F90B    1174   jb KEY.1, keypad_L0
09C1 1209A4    1175   lcall Wait25ms ; debounce
09C4 20F905    1176   jb KEY.1, keypad_L0
09C7 30F9FD    1177   jnb KEY.1, $ ; The key was pressed, wait for release
09CA C3        1178   clr c
09CB 22        1179   ret
09CC           1180   
09CC           1181   keypad_L0:
09CC           1182   ; Make all the rows zero.  If any column is zero then a key is pressed.
09CC C292      1183   clr ROW1
09CE C294      1184   clr ROW2
09D0 C296      1185   clr ROW3
09D2 C2A0      1186   clr ROW4
09D4 A2A2      1187   mov c, COL1
09D6 82A4      1188   anl c, COL2
09D8 82A6      1189   anl c, COL3
09DA 82B0      1190   anl c, COL4
09DC 5002      1191   jnc Keypad_Debounce
09DE C3        1192   clr c
09DF 22        1193   ret
09E0           1194   
09E0           1195   Keypad_Debounce:
09E0           1196   ; A key maybe pressed.  Wait and check again to discard bounces.
09E0 1209A4    1197   lcall Wait25ms ; debounce
09E3 A2A2      1198   mov c, COL1
09E5 82A4      1199   anl c, COL2
09E7 82A6      1200   anl c, COL3
09E9 82B0      1201   anl c, COL4
09EB 5002      1202   jnc Keypad_Key_Code
09ED C3        1203   clr c
09EE 22        1204   ret
09EF           1205   
09EF           1206   Keypad_Key_Code:
09EF           1207   ; A key is pressed.  Find out which one by checking each possible column and row combination.
09EF           1208   
09EF D292      1209   setb ROW1
09F1 D294      1210   setb ROW2
09F3 D296      1211   setb ROW3
09F5 D2A0      1212   setb ROW4
09F7           1213   
               1213   $MESSAGE TIP: SW0 is used to control the layout of the keypad. SW0=0: unmodified keypad. SW0=1: keypad rotated 90 deg CCW
09F7           1215   
