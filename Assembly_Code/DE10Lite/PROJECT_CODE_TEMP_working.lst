002E             73   ; In the 8051 we can define direct access variables starting at location 0x30 up to location 0x7F
0030             74   dseg at 0x30
0030             75   Count1ms:     ds 2 ; Used to determine when half second has passed
0032             76   BCD_counter:  ds 1 ; The BCD counter incrememted in the ISR and displayed in the main loop
0033             77   beep_count: ds 1
0034             78   beep_state: ds 1
