0986           1115   Configure_Keypad_Pins:
0986           1116   ; Configure the row pins as output and the column pins as inputs
0986 439B54    1117   orl P1MOD, #0b_01010100 ; P1.6, P1.4, P1.2 output
0989 439C01    1118   orl P2MOD, #0b_00000001 ; P2.0 output
098C 539CAB    1119   anl P2MOD, #0b_10101011 ; P2.6, P2.4, P2.2 input
