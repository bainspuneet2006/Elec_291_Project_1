0000             22   CLK           EQU 33333333 ; Microcontroller system crystal frequency in Hz
0000             23   TIMER0_RATE   EQU 4096     ; 2048Hz squarewave (peak amplitude of CEM-1203 speaker)
0000             24   TIMER0_RELOAD EQU ((65536-(CLK/(12*TIMER0_RATE)))) ; The prescaler in the CV-8052 is always 12 unlike the N76E003 where is selectable.
0000             25   TIMER2_RATE   EQU 1000     ; 1000Hz, for a timer tick of 1ms
0000             26   TIMER2_RELOAD EQU ((65536-(CLK/(12*TIMER2_RATE))))
0000             27   
0000             28   SOUND_OUT     equ P1.5
0000             29   UPDOWN        equ SWA.0
0000             30   Play_beeps_Switch equ SWA.1
0000             31   
0000             32   ; Unfortunately the maximum baurate we can use with timer 1 is 57600
0000             33   ; so make sure you configure putty/matlab/python accordingly.
0000             34   BAUD            EQU 57600
0000             35   TIMER_1_RELOAD  EQU (256-((2*CLK)/(12*32*BAUD)))
