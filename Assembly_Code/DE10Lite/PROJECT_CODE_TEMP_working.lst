0A07           1211   ; This subroutine scans a 4x4 keypad.  If a key is pressed sets the carry
0A07           1212   ; to one and returns the key code in register R7.
0A07           1213   ; It works with both a default keypad or a modified keypad with the labels
0A07           1214   ; rotated 90 deg ccw.  The type of keypad is determined by SW0, which is bit SWA.0
0A07           1215   Keypad:
0A07           1216   ; First check the backspace/correction pushbutton.  We use KEY1 for this function.
               1216   $MESSAGE TIP: KEY1 is the erase key
0A07 20F90B    1218   jb KEY.1, keypad_L0
0A0A 1209ED    1219   lcall Wait25ms ; debounce
0A0D 20F905    1220   jb KEY.1, keypad_L0
0A10 30F9FD    1221   jnb KEY.1, $ ; The key was pressed, wait for release
0A13 C3        1222   clr c
0A14 22        1223   ret
0A15           1224   
0A15           1225   keypad_L0:
0A15           1226   ; Make all the rows zero.  If any column is zero then a key is pressed.
0A15 C292      1227   clr ROW1
0A17 C294      1228   clr ROW2
0A19 C296      1229   clr ROW3
0A1B C2A0      1230   clr ROW4
0A1D A2A2      1231   mov c, COL1
0A1F 82A4      1232   anl c, COL2
0A21 82A6      1233   anl c, COL3
0A23 82B0      1234   anl c, COL4
0A25 5002      1235   jnc Keypad_Debounce
0A27 C3        1236   clr c
0A28 22        1237   ret
0A29           1238   
0A29           1239   Keypad_Debounce:
0A29           1240   ; A key maybe pressed.  Wait and check again to discard bounces.
0A29 1209ED    1241   lcall Wait25ms ; debounce
0A2C A2A2      1242   mov c, COL1
0A2E 82A4      1243   anl c, COL2
0A30 82A6      1244   anl c, COL3
0A32 82B0      1245   anl c, COL4
0A34 5002      1246   jnc Keypad_Key_Code
0A36 C3        1247   clr c
0A37 22        1248   ret
0A38           1249   
