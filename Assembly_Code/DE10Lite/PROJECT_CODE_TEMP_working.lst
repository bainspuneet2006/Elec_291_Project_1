0C4D 4000      1414       DB 40h,00h   ; 6  -> LEDRA.6
0C4F 8000      1415       DB 80h,00h   ; 7  -> LEDRA.7
0C51 0001      1416       DB 00h,01h   ; 8  -> LEDRB.0
0C53 0002      1417       DB 00h,02h   ; 9  -> LEDRB.1
0C55 0004      1418       DB 00h,04h   ; A  -> LEDRB.2
0C57 0008      1419       DB 00h,08h   ; B  -> LEDRB.3
0C59 0010      1420       DB 00h,10h   ; C  -> LEDRB.4
0C5B 0020      1421       DB 00h,20h   ; D  -> LEDRB.5
0C5D 0040      1422       DB 00h,40h   ; E  -> LEDRB.6
0C5F 0080      1423       DB 00h,80h   ; F  -> LEDRB.7
