08E1           1217   Configure_Keypad_Pins:
08E1           1218            ; Configure the row pins as output and the column pins as inputs
08E1 439B54    1219            orl P1MOD, #0b_01010100 ; P1.6, P1.4, P1.2 output
08E4 439C01    1220            orl P2MOD, #0b_00000001 ; P2.0 output
08E7 539CAB    1221            anl P2MOD, #0b_10101011 ; P2.6, P2.4, P2.2 input
08EA 539DFE    1222            anl P3MOD, #0b_11111110 ; P3.0 input
08ED 22        1223            ret
08EE           1224   
08EE           1225   ; These are the pins used for the keypad in this program:
08EE           1226   ROW1 EQU P1.2
08EE           1227   ROW2 EQU P1.4
08EE           1228   ROW3 EQU P1.6
08EE           1229   ROw4 EQU P2.0
08EE           1230   COL1 EQU P2.2
08EE           1231   COL2 EQU P2.4
08EE           1232   COL3 EQU P2.6
08EE           1233   COL4 EQU P3.0
