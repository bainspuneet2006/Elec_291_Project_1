04C4            363   ; =======================================================
04C4            364   ; Display_TempC_7Seg
04C4            365   ; Displays temperature (integer °C) on HEX2 HEX1 HEX0
04C4            366   ; Uses:
04C4            367   ;   t_hot  = centi-°C (°C*100)  [already computed in VoutmV_To_TempC]
04C4            368   ;   math32 div32 (x = x/y)
04C4            369   ; Reuses T_7seg table (0..9)
04C4            370   ; =======================================================
04C4            371   Display_TempC_7Seg:
04C4 C0E0       372       push acc
04C6 C0F0       373       push b
04C8 C082       374       push dpl
04CA C083       375       push dph
04CC            376   
04CC            377       ; x = t_hot (centi-°C)
04CC 854E35     378       mov x+0, t_hot+0
04CF 854F36     379       mov x+1, t_hot+1
04D2 855037     380       mov x+2, t_hot+2
04D5 855138     381       mov x+3, t_hot+3
04D8            382   
04D8            383       ; x = x / 100  -> integer °C
04D8 753964     384            mov y+0, #low (100 % 0x10000) 
04DB 753A00     384            mov y+1, #high(100 % 0x10000) 
04DE 753B00     384            mov y+2, #low (100 / 0x10000) 
04E1 753C00     384            mov y+3, #high(100 / 0x10000) 
04E4 1202FE     385       lcall div32              ; x now = integer °C
04E7            386   
04E7            387       ; Copy integer temp to R3:R4 (16-bit is enough)
04E7 AC35       388       mov R4, x+0
04E9 AB36       389       mov R3, x+1
04EB            390   
04EB            391       ; -------------------------
04EB            392       ; Compute hundreds in R2
04EB            393       ; -------------------------
04EB 7A00       394       mov R2, #0               ; hundreds
04ED            395   
04ED            396   DT_Hund_Loop:
04ED            397       ; if (R3:R4) < 100 stop
04ED EB         398       mov a, R3
04EE 7006       399       jnz DT_Hund_Sub
04F0 EC         400       mov a, R4
04F1 C3         401       clr c
04F2 9464       402       subb a, #100
04F4 400C       403       jc  DT_Hund_Done
04F6            404   
04F6            405   DT_Hund_Sub:
04F6            406       ; (R3:R4) -= 100
04F6 EC         407       mov a, R4
04F7 C3         408       clr c
04F8 9464       409       subb a, #100
04FA FC         410       mov R4, a
04FB EB         411       mov a, R3
04FC 9400       412       subb a, #0
04FE FB         413       mov R3, a
04FF 0A         414       inc R2
0500 80EB       415       sjmp DT_Hund_Loop
0502            416   
0502            417   DT_Hund_Done:
0502            418       ; Now R2 = hundreds (0..9), remaining value in R4 is 0..99
0502            419   
0502            420       ; tens/ones from remaining
0502 EC         421       mov a, R4
0503 75F00A     422       mov b, #10
0506 84         423       div ab                   ; A=tens (0..9), B=ones (0..9)
0507 F9         424       mov R1, A                ; tens
0508 A8F0       425       mov R0, B                ; ones
050A            426   
050A            427       ; -------------------------
050A            428       ; Map digits to 7-seg and write HEX2..HEX0
050A            429       ; -------------------------
050A 90040F     430       mov dptr, #T_7seg
050D            431   
050D            432       ; ones -> HEX0
050D E8         433       mov a, R0
050E 93         434       movc a, @a+dptr
050F F591       435       mov HEX0, a
0511            436   
0511            437       ; tens -> HEX1 (blank if hundreds=0 and tens=0)
0511 EA         438       mov a, R2
0512 7008       439       jnz DT_Show_Tens
0514 E9         440       mov a, R1
0515 7005       441       jnz DT_Show_Tens
0517 7592FF     442       mov HEX1, #0FFh
051A 8004       443       sjmp DT_Do_Hund
051C            444   
051C            445   DT_Show_Tens:
051C E9         446       mov a, R1
051D 93         447       movc a, @a+dptr
051E F592       448       mov HEX1, a
0520            449   
0520            450   DT_Do_Hund:
0520            451       ; hundreds -> HEX2 (blank if 0)
0520 EA         452       mov a, R2
0521 7005       453       jnz DT_Show_Hund
0523 7593FF     454       mov HEX2, #0FFh
0526 8004       455       sjmp DT_Done
0528            456   
0528            457   DT_Show_Hund:
0528 EA         458       mov a, R2
0529 93         459       movc a, @a+dptr
052A F593       460       mov HEX2, a
052C            461   
052C            462   DT_Done:
052C D083       463       pop dph
052E D082       464       pop dpl
0530 D0F0       465       pop b
0532 D0E0       466       pop acc
0534 22         467       ret
