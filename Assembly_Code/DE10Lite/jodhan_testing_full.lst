0000             47   GSENSOR_SCLK BIT 0xfe
0000             48   GSENSOR_CS_n BIT 0xff
0000             49   
0000             50   ; Tilt threshold (16-bit). Tune this for demo.
0000             51   ; Start at 0x0600. If too sensitive -> 0x0800. If not sensitive -> 0x0400.
0000             52   TILT_TH_HI  EQU 00h
0000             53   TILT_TH_LO  EQU 0C0h
0000             54   
0000             55   BAUD            EQU 57600
0000             56   TIMER_1_RELOAD  EQU (256-((2*CLK)/(12*32*BAUD)))
